+// These types and the geometry below are owned by the frozen backend adapter.
+// The policy library only sees the POD decision/event representation from
+// edgepace_policy_abi.h.
+enum class phase : uint32_t {
+    none = EDGEPACE_POLICY_PHASE_NONE,
+    vision = EDGEPACE_POLICY_PHASE_VISION,
+    prefill = EDGEPACE_POLICY_PHASE_PREFILL,
+    decode = EDGEPACE_POLICY_PHASE_DECODE,
+};
+
+enum class mode : uint32_t {
+    normal = EDGEPACE_POLICY_MODE_NORMAL,
+    protected_mode = EDGEPACE_POLICY_MODE_PROTECTED,
+    hold = EDGEPACE_POLICY_MODE_HOLD,
+};
+
+struct quantum {
+    int end_layer;
+    double runtime_ms;
+};
+
+struct decision {
+    mode selected_mode;
+    uint16_t flags;
+    int outstanding_limit;
+    uint32_t post_hold_quantum;
+    uint32_t task_valid;
+    uint32_t request_valid;
+    uint32_t mc_valid;
+    uint32_t pmu_valid;
+    uint32_t actmon_aux_valid;
+    uint32_t crosses_high_risk;
+    uint32_t freshness_recoverable;
+    uint32_t freshness_rescue;
+    uint32_t yield_requested;
+    uint64_t request_id;
+    uint64_t frame_id;
+    uint64_t mc_activity;
+    double next_quantum_ms;
+    double fg_deadline_remaining_ms;
+    double fg_predicted_remaining_ms;
+    double time_to_next_high_risk_ms;
+    double foreground_elapsed_ms;
+    double vlm_freshness_remaining_ms;
+    double estimated_remaining_service_ms;
+    double u_deadline;
+    double u_phase;
+    double u_mc;
+    double pmu_demand;
+    double pmu_stall;
+    double actmon_aux;
+    double signal_age_ms;
+    double online_risk;
+    double u_fresh;
+    double c_quantum;
+    double p_fg;
+    double p_vlm;
+    double delta_p;
+    double safe_budget_ms;
+    double admission_budget_ms;
+    double total_guard_ms;
+    double freshness_reserve_ms;
+    uint64_t pmu_sample_index;
+    char fg_phase[EDGEPACE_POLICY_PHASE_BYTES];
+    char reason[EDGEPACE_POLICY_REASON_BYTES];
+};
+
+struct completion {
+    phase graph_phase;
+    int quantum_id;
+    uint64_t serial;
+    uint64_t graph_uid;
+    uint64_t submit_ns;
+    double predicted_ms;
+    uint32_t post_hold_quantum;
+    decision admitted;
+};
+
+inline uint64_t monotonic_ns() {
+    timespec value{};
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    return static_cast<uint64_t>(value.tv_sec) * UINT64_C(1000000000) +
+           static_cast<uint64_t>(value.tv_nsec);
+}
+
+inline const char * phase_name(phase value) {
+    switch (value) {
+        case phase::vision: return "vision";
+        case phase::prefill: return "prefill";
+        case phase::decode: return "decode";
+        default: return "none";
+    }
+}
+
+inline uint32_t phase_value(phase value) {
+    return static_cast<uint32_t>(value);
+}
+
+inline const char * mode_name(mode value) {
+    switch (value) {
+        case mode::normal: return "NORMAL";
+        case mode::protected_mode: return "PROTECTED";
+        case mode::hold: return "HOLD";
+    }
+    return "NORMAL";
+}
+
+inline double env_double(const char * name, double fallback) {
+    const char * text = std::getenv(name);
+    if (text == nullptr || *text == '\0') return fallback;
+    char * end = nullptr;
+    errno = 0;
+    const double value = std::strtod(text, &end);
+    return errno == 0 && end != text && *end == '\0' && std::isfinite(value)
+        ? value : fallback;
+}
+
+inline int env_int(const char * name, int fallback) {
+    const char * text = std::getenv(name);
+    if (text == nullptr || *text == '\0') return fallback;
+    char * end = nullptr;
+    errno = 0;
+    const long value = std::strtol(text, &end, 10);
+    return errno == 0 && end != text && *end == '\0' && value >= 0 &&
+                   value <= std::numeric_limits<int>::max()
+        ? static_cast<int>(value) : fallback;
+}
+
+inline bool env_bool(const char * name, bool fallback) {
+    return env_int(name, fallback ? 1 : 0) != 0;
+}
+
+class runtime {
+public:
+    static runtime & instance() {
+        static runtime value;
+        return value;
+    }
+
+    runtime() {
+        const char * policy = std::getenv("EDGEPACE_POLICY");
+        policy_ = policy == nullptr ? "off" : policy;
+        model_layer_count_ = std::max(
+            1, env_int("EDGEPACE_MODEL_LAYER_COUNT", model_layer_count_));
+        prefill_sublayer_boundaries_ = env_bool(
+            "EDGEPACE_PREFILL_SUBLAYER_BOUNDARIES", false);
+        // vision-encoder cut points inside each layer, in graph order,
+        // as clip callback names ("<name>-<layer>"); boundary k*layer + i is the
+        // i-th of the k names in layer `layer`.  Default: one per layer.
+        vision_boundaries_ = split_names(std::getenv("EDGEPACE_VISION_BOUNDARIES"), "layer_out");
+        // text prefill cut points the same way (k names per layer, boundary
+        // k*layer + i, then result_norm / result_output); the default is the
+        // historical sublayer pair ffn_inp,l_out (or l_out alone)
+        prefill_boundaries_ = split_names(std::getenv("EDGEPACE_PREFILL_BOUNDARIES"),
+                                          prefill_sublayer_boundaries_ ? "ffn_inp,l_out" : "l_out");
+        if (policy_ != "off" && policy_ != "unmanaged") {
+            load_frozen_plan();
+            load_policy();
+        }
+    }
+
+    runtime(const runtime &) = delete;
+    runtime & operator=(const runtime &) = delete;
+
+    ~runtime() {
+        if (destroy_ != nullptr && policy_handle_ != nullptr) {
+            destroy_(policy_handle_);
+        }
+        if (library_handle_ != nullptr) {
+            dlclose(library_handle_);
+        }
+    }
+
+    bool enabled() const { return enabled_; }
+
+    bool active_request() {
+        if (!enabled_) return false;
+        uint64_t request_id = 0;
+        const int result = active_request_(policy_handle_, &request_id);
+        if (result < 0) {
+            throw std::runtime_error("external policy active_request failed");
+        }
+        return result != 0;
+    }
+
+    bool prefill_sublayer_boundaries() const {
+        return prefill_sublayer_boundaries_;
+    }
+
+    int model_layer_count() const { return model_layer_count_; }
+
+    const std::vector<std::string> & vision_boundaries() const { return vision_boundaries_; }
+
+    const std::vector<std::string> & prefill_boundaries() const { return prefill_boundaries_; }
+
+    const std::vector<quantum> & quanta(phase value) const {
+        if (value == phase::vision) return vision_chunks_;
+        if (value == phase::prefill) return prefill_chunks_;
+        return decode_chunks_;
+    }
+
+    double next_decode_runtime_ms(int quantum_id) {
+        if (!enabled_) return 0.0;
+        std::lock_guard<std::mutex> lock(mutex_);
+        double value = 0.0;
+        if (decode_runtime_map_ && quantum_id >= 0 &&
+            static_cast<size_t>(quantum_id) < decode_chunks_.size()) {
+            value = decode_chunks_[quantum_id].runtime_ms;
+        } else {
+            const double token_ms = decode_tokens_completed_ == 0
+                ? first_decode_ms_
+                : later_decode_ms_[std::min<size_t>(
+                    decode_tokens_completed_ - 1, later_decode_ms_.size() - 1)];
+            value = token_ms / std::max<size_t>(decode_chunks_.size(), 1);
+        }
+        if (!std::isfinite(value) || value <= 0.0) {
+            throw std::runtime_error("frozen backend plan returned invalid decode runtime");
+        }
+        return value;
+    }
+
+    uint64_t next_serial() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return ++serial_;
+    }
+
+    uint64_t next_execution_id() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return ++execution_id_;
+    }
+
+    decision evaluate(phase graph_phase, double next_quantum_ms,
+                      int quantum_id = -1, int outstanding = -1,
+                      uint64_t execution_id = 0) {
+        if (!enabled_) {
+            decision result{};
+            result.selected_mode = mode::normal;
+            result.outstanding_limit = 1;
+            result.next_quantum_ms = next_quantum_ms;
+            return result;
+        }
+
+        edgepace_policy_input_v1 input{};
+        input.abi_version = EDGEPACE_POLICY_ABI_VERSION;
+        input.bytes = sizeof(input);
+        input.phase = phase_value(graph_phase);
+        input.quantum_id = quantum_id;
+        input.outstanding = outstanding;
+        input.now_ns = monotonic_ns();
+        input.execution_id = execution_id;
+        input.next_quantum_ms = next_quantum_ms;
+
+        edgepace_policy_decision_v1 output{};
+        const int status = evaluate_(policy_handle_, &input, &output);
+        if (status != 0) {
+            throw std::runtime_error("external policy evaluate failed");
+        }
+        validate_output(output);
+        decision result = from_abi(output);
+        if (result.request_id != 0) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (result.request_id != last_request_id_) {
+                last_request_id_ = result.request_id;
+                decode_tokens_completed_ = 0;
+            }
+        }
+        return result;
+    }
+
+    void submitted(const completion & value, int outstanding_after) {
+        send_event(EDGEPACE_POLICY_EVENT_SUBMIT, "submit", value,
+                   outstanding_after, value.admitted.outstanding_limit,
+                   value.submit_ns, 0);
+    }
+
+    void completed(const completion & value, int outstanding_after,
+                   uint64_t complete_ns) {
+        send_event(EDGEPACE_POLICY_EVENT_COMPLETE, "complete", value,
+                   outstanding_after, value.admitted.outstanding_limit,
+                   value.submit_ns, complete_ns);
+        if (value.graph_phase == phase::decode &&
+            value.quantum_id == static_cast<int>(decode_chunks_.size()) - 1) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ++decode_tokens_completed_;
+        }
+    }
+
+    void admission(const char * event, phase graph_phase, int quantum_id,
+                   uint64_t graph_uid, const decision & admitted,
+                   int outstanding, int limit) {
+        completion value{};
+        value.graph_phase = graph_phase;
+        value.quantum_id = quantum_id;
+        value.graph_uid = graph_uid;
+        value.serial = serial_;
+        value.predicted_ms = admitted.next_quantum_ms;
+        value.post_hold_quantum = admitted.post_hold_quantum;
+        value.admitted = admitted;
+        send_event(EDGEPACE_POLICY_EVENT_ADMISSION, event, value,
+                   outstanding, limit, 0, 0);
+    }
+
+    const std::string & policy() const { return policy_; }
+
+private:
+    using create_fn = edgepace_policy_create_v1_fn;
+    using destroy_fn = edgepace_policy_destroy_v1_fn;
+    using enabled_fn = edgepace_policy_enabled_v1_fn;
+    using active_request_fn = edgepace_policy_active_request_v1_fn;
+    using evaluate_fn = edgepace_policy_evaluate_v1_fn;
+    using event_fn = edgepace_policy_event_v1_fn;
+
+    template <typename Function>
+    Function load_symbol(const char * name) {
+        dlerror();
+        void * symbol = dlsym(library_handle_, name);
+        const char * error = dlerror();
+        if (error != nullptr || symbol == nullptr) {
+            throw std::runtime_error(
+                std::string("missing external policy symbol ") + name +
+                (error == nullptr ? "" : std::string(": ") + error));
+        }
+        return reinterpret_cast<Function>(symbol);
+    }
+
+    void load_policy() {
+        const char * library_path = std::getenv("EDGEPACE_POLICY_LIBRARY");
+        if (library_path == nullptr || *library_path == '\0') {
+            library_path = std::getenv("EDGEPACE_POLICY_LIBRARY");
+        }
+        if (library_path == nullptr || *library_path == '\0') {
+            throw std::runtime_error(
+                "EDGEPACE_POLICY is enabled but EDGEPACE_POLICY_LIBRARY is unset");
+        }
+
+        library_handle_ = dlopen(library_path, RTLD_NOW | RTLD_LOCAL);
+        if (library_handle_ == nullptr) {
+            throw std::runtime_error(
+                std::string("cannot load external policy ") + dlerror());
+        }
+        try {
+            create_ = load_symbol<create_fn>("edgepace_policy_create_v1");
+            destroy_ = load_symbol<destroy_fn>("edgepace_policy_destroy_v1");
+            enabled_fn_ = load_symbol<enabled_fn>("edgepace_policy_enabled_v1");
+            active_request_ = load_symbol<active_request_fn>(
+                "edgepace_policy_active_request_v1");
+            evaluate_ = load_symbol<evaluate_fn>(
+                "edgepace_policy_evaluate_v1");
+            on_event_ = load_symbol<event_fn>("edgepace_policy_on_event_v1");
+            policy_handle_ = create_();
+            if (policy_handle_ == nullptr) {
+                throw std::runtime_error("external policy create failed");
+            }
+            if (enabled_fn_(policy_handle_) <= 0) {
+                throw std::runtime_error("external policy rejected configuration");
+            }
+            enabled_ = true;
+        } catch (...) {
+            if (policy_handle_ != nullptr && destroy_ != nullptr) {
+                destroy_(policy_handle_);
+                policy_handle_ = nullptr;
+            }
+            dlclose(library_handle_);
+            library_handle_ = nullptr;
+            throw;
+        }
+    }
+
+    static std::vector<std::string> split_names(const char * configured, const char * fallback) {
+        std::istringstream input(configured == nullptr || *configured == '\0' ? fallback : configured);
+        std::vector<std::string> result;
+        std::string item;
+        while (std::getline(input, item, ',')) {
+            if (!item.empty()) result.push_back(item);
+        }
+        return result;
+    }
+
+    static std::vector<quantum> parse_chunks(const char * name,
+                                             const char * fallback) {
+        const char * configured = std::getenv(name);
+        std::istringstream input(configured == nullptr ? fallback : configured);
+        std::vector<quantum> result;
+        std::string item;
+        while (std::getline(input, item, ',')) {
+            const size_t separator = item.find(':');
+            if (separator == std::string::npos) continue;
+            char * layer_end = nullptr;
+            char * runtime_end = nullptr;
+            const long layer = std::strtol(item.c_str(), &layer_end, 10);
+            const double runtime = std::strtod(
+                item.c_str() + separator + 1, &runtime_end);
+            if (layer_end != item.c_str() + separator || runtime_end == nullptr ||
+                *runtime_end != '\0' || layer < 0 || !std::isfinite(runtime) ||
+                runtime <= 0.0) {
+                continue;
+            }
+            result.push_back({static_cast<int>(layer), runtime});
+        }
+        return result;
+    }
+
+    static void validate_plan(const char * name,
+                              const std::vector<quantum> & plan) {
+        if (plan.empty() || plan.size() > 4096) {
+            throw std::runtime_error(std::string("invalid frozen ") + name +
+                                     " quantum plan");
+        }
+        int previous_layer = -1;
+        for (const quantum & value : plan) {
+            if (value.end_layer <= previous_layer ||
+                !std::isfinite(value.runtime_ms) || value.runtime_ms <= 0.0) {
+                throw std::runtime_error(std::string("invalid frozen ") + name +
+                                         " quantum ordering");
+            }
+            previous_layer = value.end_layer;
+        }
+    }
+
+    void load_frozen_plan() {
+        first_decode_ms_ = env_double("EDGEPACE_FIRST_DECODE_MS", first_decode_ms_);
+        later_decode_ms_[0] = env_double(
+            "EDGEPACE_LATER_DECODE_1_MS", later_decode_ms_[0]);
+        later_decode_ms_[1] = env_double(
+            "EDGEPACE_LATER_DECODE_2_MS", later_decode_ms_[1]);
+        later_decode_ms_[2] = env_double(
+            "EDGEPACE_LATER_DECODE_3_MS", later_decode_ms_[2]);
+        vision_chunks_ = parse_chunks(
+            "EDGEPACE_VISION_MAP",
+            "1:24.465647,3:24.479306,5:24.154225,7:24.220781,"
+            "9:23.972264,10:12.125986,12:23.953936,14:24.207643,"
+            "16:24.224282,18:24.067503,20:23.94738,22:23.580403,"
+            "24:23.607025,26:23.702985");
+        const bool builtin_f16_plan = env_bool("EDGEPACE_BUILTIN_F16_PLAN", false);
+        if (builtin_f16_plan) prefill_sublayer_boundaries_ = true;
+        prefill_chunks_ = parse_chunks(
+            "EDGEPACE_PREFILL_MAP",
+            builtin_f16_plan
+                ? "0:0.38667,1:2.14229,2:0.410799,3:1.716481,4:0.42232,5:1.721026,6:0.420304,7:1.71805,8:0.420656,9:1.949002,10:0.418543,11:1.938666,12:0.417648,13:1.711361,14:0.422896,15:1.716257,16:0.420848,17:1.715841,18:0.412591,19:1.920905,20:0.420912,21:1.94657,22:0.42056,23:1.94225,24:0.418576,25:1.959242,26:0.417072,27:1.720001,28:0.418864,29:1.945866,30:0.419408,31:1.941034,32:0.42296,33:1.947338,34:0.418064,35:1.934473,36:0.41752,37:1.72141,38:0.418,39:1.713793,40:0.420208,41:1.714369,42:0.415631,43:1.950282,44:0.415376,45:1.938601,46:0.417328,47:1.715425,48:0.41912,49:1.716578,50:0.418288,51:1.719329,52:0.424976,53:1.715041,54:0.395983,55:1.312306,56:0.029153,57:11.617178"
+                : "7:23.79717,15:24.587234,23:23.173343");
+        const char * decode_map = std::getenv("EDGEPACE_DECODE_MAP");
+        const char * decode_default = builtin_f16_plan
+            ? "0:1.440151,1:1.488665,2:1.484889,3:1.501817,4:1.491545,5:1.505657,6:1.495257,7:1.512378,8:1.504729,9:1.504025,10:1.498937,11:1.502233,12:1.501433,13:1.500601,14:1.498553,15:1.505177,16:1.503769,17:1.500569,18:1.495289,19:1.502649,20:1.494937,21:1.501753,22:1.496921,23:1.501017,24:1.496313,25:1.502714,26:1.501401,27:1.457879,28:0.034433,29:10.913566"
+            : "";
+        if (decode_map != nullptr && *decode_map != '\0') {
+            decode_chunks_ = parse_chunks("EDGEPACE_DECODE_MAP", decode_default);
+            decode_runtime_map_ = !decode_chunks_.empty();
+        }
+        if (decode_chunks_.empty()) {
+            const int decode_layer_count = std::max(
+                1, env_int("EDGEPACE_DECODE_LAYER_COUNT", model_layer_count_));
+            for (int layer = 0; layer < decode_layer_count; ++layer) {
+                decode_chunks_.push_back({
+                    layer, first_decode_ms_ / decode_layer_count});
+            }
+        }
+        validate_plan("vision", vision_chunks_);
+        validate_plan("prefill", prefill_chunks_);
+        validate_plan("decode", decode_chunks_);
+    }
+
+    static void copy_text(char * destination, size_t capacity,
+                          const char * source) {
+        if (capacity == 0) return;
+        const char * value = source == nullptr ? "" : source;
+        size_t length = 0;
+        while (length + 1 < capacity && value[length] != '\0') ++length;
+        std::memcpy(destination, value, length);
+        destination[length] = '\0';
+    }
+
+    static edgepace_policy_decision_v1 to_abi(const decision & value) {
+        edgepace_policy_decision_v1 output{};
+        output.abi_version = EDGEPACE_POLICY_ABI_VERSION;
+        output.bytes = sizeof(output);
+        output.selected_mode = static_cast<uint32_t>(value.selected_mode);
+        output.outstanding_limit = value.outstanding_limit;
+        output.post_hold_quantum = value.post_hold_quantum;
+        output.task_valid = value.task_valid;
+        output.request_valid = value.request_valid;
+        output.mc_valid = value.mc_valid;
+        output.pmu_valid = value.pmu_valid;
+        output.actmon_aux_valid = value.actmon_aux_valid;
+        output.crosses_high_risk = value.crosses_high_risk;
+        output.freshness_recoverable = value.freshness_recoverable;
+        output.freshness_rescue = value.freshness_rescue;
+        output.yield_requested = value.yield_requested;
+        output.request_id = value.request_id;
+        output.frame_id = value.frame_id;
+        output.mc_activity = value.mc_activity;
+        output.next_quantum_ms = value.next_quantum_ms;
+        output.fg_deadline_remaining_ms = value.fg_deadline_remaining_ms;
+        output.fg_predicted_remaining_ms = value.fg_predicted_remaining_ms;
+        output.time_to_next_high_risk_ms = value.time_to_next_high_risk_ms;
+        output.foreground_elapsed_ms = value.foreground_elapsed_ms;
+        output.vlm_freshness_remaining_ms = value.vlm_freshness_remaining_ms;
+        output.estimated_remaining_service_ms = value.estimated_remaining_service_ms;
+        output.u_deadline = value.u_deadline;
+        output.u_phase = value.u_phase;
+        output.u_mc = value.u_mc;
+        output.pmu_demand = value.pmu_demand;
+        output.pmu_stall = value.pmu_stall;
+        output.actmon_aux = value.actmon_aux;
+        output.signal_age_ms = value.signal_age_ms;
+        output.online_risk = value.online_risk;
+        output.u_fresh = value.u_fresh;
+        output.c_quantum = value.c_quantum;
+        output.p_fg = value.p_fg;
+        output.p_vlm = value.p_vlm;
+        output.delta_p = value.delta_p;
+        output.safe_budget_ms = value.safe_budget_ms;
+        output.admission_budget_ms = value.admission_budget_ms;
+        output.total_guard_ms = value.total_guard_ms;
+        output.freshness_reserve_ms = value.freshness_reserve_ms;
+        output.pmu_sample_index = value.pmu_sample_index;
+        copy_text(output.fg_phase, sizeof(output.fg_phase), value.fg_phase);
+        copy_text(output.reason, sizeof(output.reason), value.reason);
+        return output;
+    }
+
+    static decision from_abi(const edgepace_policy_decision_v1 & value) {
+        decision output{};
+        output.flags = value.flags;
+        output.selected_mode = static_cast<mode>(value.selected_mode);
+        output.outstanding_limit = value.outstanding_limit;
+        output.post_hold_quantum = value.post_hold_quantum;
+        output.task_valid = value.task_valid;
