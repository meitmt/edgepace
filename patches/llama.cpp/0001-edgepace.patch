+std::uint32_t fraction_q16(std::uint64_t numerator, std::uint64_t denominator) {
+    if (denominator == 0) {
+        return 0;
+    }
+    return static_cast<std::uint32_t>(std::min<std::uint64_t>(
+        65535, (numerator * 65535ULL + denominator / 2) / denominator));
+}
