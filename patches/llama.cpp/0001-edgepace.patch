diff --git a/external/edgepace_policy/include/conserve/slo_budget.h b/external/edgepace_policy/include/conserve/slo_budget.h
new file mode 100644
index 000000000..612a12bb5
--- /dev/null
+++ b/external/edgepace_policy/include/conserve/slo_budget.h
@@ -0,0 +1,109 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace conserve {
+
+enum class fg_phase : uint32_t {
+    low = 0,
+    tracking = 1,
+    fg_high_risk = 2,
+};
+
+struct budget_parameters {
+    int64_t base_guard_us = 3333;
+    int64_t tracking_guard_us = 2000;
+    int64_t high_risk_guard_us = 5000;
+    int64_t max_pressure_guard_us = 3000;
+    int64_t base_freshness_reserve_us = 2000;
+    int64_t freshness_warning_us = 200000;
+};
+
+struct budget_input {
+    fg_phase phase = fg_phase::low;
+    int64_t deadline_remaining_us = 0;
+    int64_t predicted_fg_remaining_us = 0;
+    int64_t time_to_next_risk_us = 0;
+    int64_t freshness_remaining_us = 0;
+    int64_t estimated_remaining_vlm_service_us = 0;
+    int64_t next_quantum_runtime_us = 0;
+    int64_t remaining_to_next_safepoint_us = 0;
+    double mc_pressure = 0.0;
+    bool mc_valid = false;
+};
+
+struct budget_decision {
+    int64_t fg_laxity_us = 0;
+    int64_t phase_guard_us = 0;
+    int64_t pressure_guard_us = 0;
+    int64_t total_guard_us = 0;
+    int64_t safe_budget_us = 0;
+    int64_t freshness_slack_us = 0;
+    double freshness_urgency = 0.0;
+    int64_t freshness_reserve_us = 0;
+    int64_t admission_budget_us = 0;
+    bool can_admit = false;
+    bool should_yield = false;
+};
+
+inline double clamp01(double value) {
+    return std::min(1.0, std::max(0.0, value));
+}
+
+inline int64_t phase_guard_us(fg_phase phase,
+                              const budget_parameters & parameters) {
+    switch (phase) {
+        case fg_phase::tracking:
+            return parameters.tracking_guard_us;
+        case fg_phase::fg_high_risk:
+            return parameters.high_risk_guard_us;
+        case fg_phase::low:
+            return 0;
+    }
+    return 0;
+}
+
+inline budget_decision compute_budget(
+        const budget_input & input,
+        const budget_parameters & parameters = budget_parameters{}) {
+    budget_decision result{};
+    result.fg_laxity_us = input.deadline_remaining_us -
+                            input.predicted_fg_remaining_us;
+    result.phase_guard_us = phase_guard_us(input.phase, parameters);
+    result.pressure_guard_us = input.mc_valid
+        ? static_cast<int64_t>(std::llround(
+              parameters.max_pressure_guard_us * clamp01(input.mc_pressure)))
+        : 0;
+    result.total_guard_us = parameters.base_guard_us + result.phase_guard_us +
+                            result.pressure_guard_us;
+    result.safe_budget_us = std::min(result.fg_laxity_us,
+                                     input.time_to_next_risk_us) -
+                            result.total_guard_us;
+
+    result.freshness_slack_us = input.freshness_remaining_us -
+                                input.estimated_remaining_vlm_service_us;
+    if (parameters.freshness_warning_us > 0) {
+        result.freshness_urgency = clamp01(
+            static_cast<double>(parameters.freshness_warning_us -
+                                result.freshness_slack_us) /
+            static_cast<double>(parameters.freshness_warning_us));
+    } else {
+        result.freshness_urgency = result.freshness_slack_us <= 0 ? 1.0 : 0.0;
+    }
+    result.freshness_reserve_us = static_cast<int64_t>(std::llround(
+        parameters.base_freshness_reserve_us *
+        (1.0 - result.freshness_urgency)));
+    result.admission_budget_us = result.safe_budget_us -
+                                 result.freshness_reserve_us;
+    result.can_admit = input.next_quantum_runtime_us >= 0 &&
+                       input.next_quantum_runtime_us <=
+                           result.admission_budget_us;
+    result.should_yield = input.remaining_to_next_safepoint_us > 0 &&
+                          input.remaining_to_next_safepoint_us >=
+                              result.safe_budget_us;
+    return result;
+}
+
+}  // namespace conserve
diff --git a/external/edgepace_policy/include/edgepace/abi.h b/external/edgepace_policy/include/edgepace/abi.h
