+    char * end = nullptr;
+    const long value = strtol(dash + 1, &end, 10);
+    if (end == nullptr || *end != '\0' || value < 0) {
+        return -1;
+    }
+    const size_t prefix = (size_t) (dash - node->name);
+    for (size_t i = 0; i < names.size(); ++i) {
+        if (names[i].size() == prefix && strncmp(node->name, names[i].c_str(), prefix) == 0) {
+            return (int) (names.size() * (size_t) value + i);
+        }
+    }
+    return -1;
