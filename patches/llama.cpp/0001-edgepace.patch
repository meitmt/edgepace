+    void log(const char * event, const completion & value,
+             int outstanding, int limit, uint64_t submit_ns,
+             uint64_t complete_ns) {
+        std::lock_guard<std::mutex> lock(log_mutex_);
+        if (!log_) return;
+        const decision & d = value.admitted;
+        log_ << monotonic_ns() << ',' << event << ',' << policy_ << ','
+             << d.request_id << ',' << value.graph_uid << ','
+             << phase_name(value.graph_phase) << ',' << value.quantum_id << ','
+             << value.serial << ',' << mode_name(d.selected_mode) << ','
+             << outstanding << ',' << limit << ',' << d.next_quantum_ms << ','
+             << d.fg_phase << ',' << d.fg_deadline_remaining_ms << ','
+             << d.fg_predicted_remaining_ms << ','
+             << d.time_to_next_high_risk_ms << ',' << d.foreground_elapsed_ms << ','
+             << d.vlm_freshness_remaining_ms << ','
+             << d.estimated_remaining_service_ms << ',' << (d.mc_valid ? 1 : 0)
+             << ',' << d.mc_activity << ',' << (d.pmu_valid ? 1 : 0) << ','
+             << d.signal_age_ms << ',' << d.pmu_demand << ',' << d.pmu_stall << ','
+             << (d.actmon_aux_valid ? 1 : 0) << ',' << d.actmon_aux << ','
+             << d.online_risk << ','
+             << (d.posterior_quantum_high_risk ? 1 : 0) << ','
+             << d.frame_service_used_ms << ','
+             << d.frame_service_budget_ms << ',' << d.frame_early_service_used_ms
+             << ',' << d.frame_early_service_budget_ms << ','
+             << d.posterior_frame_charge_used_ms << ','
+             << d.posterior_frame_charge_budget_ms << ',' << d.u_deadline << ',' << d.u_phase
+             << ',' << d.u_mc << ',' << d.u_fresh << ',' << d.c_quantum << ','
+             << (d.crosses_high_risk ? 1 : 0) << ',' << d.p_fg << ','
+             << d.p_vlm << ',' << d.delta_p << ','
+             << (d.freshness_recoverable ? 1 : 0) << ','
+             << (d.freshness_rescue ? 1 : 0) << ',' << d.safe_budget_ms << ','
+             << d.admission_budget_ms << ',' << d.total_guard_ms << ','
+             << d.freshness_reserve_ms << ',' << (d.yield_requested ? 1 : 0) << ','
+             << (value.post_hold_quantum ? 1 : 0) << ',' << submit_ns << ','
+             // the frame the decision saw.  The progress fields do not
+             // survive the server's ABI round trip (ggml-edgepace.h copies fields
+             // one by one), so gate holds are matched to the sampler's
+             // prediction.csv offline instead.
+             << complete_ns << ',' << d.frame_id << '\n';
+        if (++log_rows_since_flush_ >= static_cast<size_t>(log_flush_rows_)) {
+            log_.flush();
+            log_rows_since_flush_ = 0;
+        }
+    }
