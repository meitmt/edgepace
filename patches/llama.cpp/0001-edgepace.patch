+++ b/external/edgepace_policy/include/edgepace/abi.h
@@ -0,0 +1,183 @@
+#pragma once
+
+#include <stdint.h>
+
+#define EDGEPACE_ABI_VERSION 1u
+
+#define EDGEPACE_FULL_TASK_MAGIC 0x46535431u
+#define EDGEPACE_FULL_REQUEST_MAGIC 0x46535231u
+#define EDGEPACE_FULL_SIGNAL_MAGIC 0x46535331u
+#define EDGEPACE_ACTMON_MAGIC 0x44504d43u
+
+#define EDGEPACE_TASK_LEDGER_CAPACITY 4u
+#define EDGEPACE_TASK_FRAME_VALID (1u << 0)
+#define EDGEPACE_TASK_FRAME_COMPLETE (1u << 1)
+
+typedef struct edgepace_abi_header {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t bytes;
+    uint32_t flags;
+    uint32_t reserved;
+} edgepace_abi_header;
+
+typedef struct edgepace_task_frame_v1 {
+    uint64_t frame_id;
+    uint64_t source_ros_ns;
+    uint64_t release_ns;
+    uint64_t dequeue_ns;
+    uint64_t complete_ns;
+    uint64_t deadline_ns;
+    uint32_t flags;
+    uint32_t reserved0;
+} edgepace_task_frame_v1;
+
+// Read-only view of the registered ROS task page. EdgePace consumes timing facts
+// from this ABI; it does not consume any full_sched policy output.
+typedef struct edgepace_task_snapshot_v1 {
+    edgepace_abi_header header;
+    uint64_t sequence;
+    uint64_t update_ns;
+    uint64_t measurement_epoch;
+    uint64_t frame_id;
+    uint64_t source_ros_ns;
+
+    uint64_t odom_release_ns;
+    uint64_t odom_dequeue_ns;
+    uint64_t odom_complete_ns;
+    uint64_t odom_deadline_ns;
+    uint64_t odom_last_response_ns;
+    uint64_t odom_ewma_response_ns;
+    uint64_t odom_q90_response_ns;
+    int64_t odom_last_slack_ns;
+    int64_t odom_min_recent_slack_ns;
+    int64_t odom_response_slope_q16;
+    uint32_t odom_consecutive_misses;
+    uint32_t callback_queue_depth;
+
+    uint64_t next_odom_release_ns;
+    uint64_t next_odom_deadline_ns;
+    uint64_t second_odom_release_ns;
+    uint64_t second_odom_deadline_ns;
+
+    uint64_t graph_next_due_ns;
+    uint64_t graph_last_ingress_ns;
+    uint64_t graph_last_terminal_ns;
+    uint64_t graph_last_commit_ns;
+    uint32_t graph_ready;
+    uint32_t graph_inflight;
+    uint32_t graph_backlog;
+    uint32_t graph_cadence;
+
+    uint64_t critical_begin_ns;
+    uint64_t critical_deadline_ns;
+    uint32_t critical_kind;
+    uint32_t flags;
+    uint32_t frame_ledger_count;
+    uint32_t frame_ledger_write_index;
+    uint32_t frame_ledger_overwrites;
+    uint32_t frame_ledger_unmatched_completions;
+    edgepace_task_frame_v1 frame_ledger[EDGEPACE_TASK_LEDGER_CAPACITY];
+    uint8_t reserved[24];
+} edgepace_task_snapshot_v1;
+
+// Read-only view of the registered semantic-client request page.
+typedef struct edgepace_request_state_v1 {
+    edgepace_abi_header header;
+    uint64_t sequence;
+    uint64_t update_ns;
+    uint64_t request_id;
+    uint64_t enqueue_ns;
+    uint64_t freshness_deadline_ns;
+    uint64_t previous_source_ros_ns;
+    uint64_t current_source_ros_ns;
+    uint64_t pose_version;
+    uint64_t map_version;
+    uint64_t last_boundary_ns;
+    uint64_t last_submit_ns;
+    uint32_t phase;
+    uint32_t running;
+    uint32_t completed_units;
+    uint32_t estimated_remaining_units;
+    uint32_t terminal_disposition;
+    uint32_t flags;
+    uint8_t input_hash[32];
+    uint8_t model_config_hash[32];
+    uint8_t reserved[64];
+} edgepace_request_state_v1;
+
+// Read-only view of the full-scheduler PMU signal page. PMU fields describe
+// the foreground CPU threads; MC activity remains an auxiliary aggregate.
+typedef struct edgepace_signal_snapshot_v1 {
+    edgepace_abi_header header;
+    uint64_t sequence;
+    uint64_t update_ns;
+    uint64_t sample_index;
+    uint64_t actual_interval_ns;
+    uint64_t read_duration_ns;
+
+    uint64_t delta_cpu_cycles;
+    uint64_t delta_inst_retired;
+    uint64_t delta_stall_backend_mem;
+    uint64_t delta_ll_cache_miss_rd;
+    uint32_t active_tids;
+    uint32_t opened_tids;
+    uint32_t pmu_valid;
+    uint32_t pmu_source_id;
+    uint32_t pmu_time_running_q16;
+    uint32_t pmu_counter_reset;
+
+    uint32_t demand_pressure_q16;
+    uint32_t stall_pressure_q16;
+    uint32_t demand_ewma_q16;
+    uint32_t stall_ewma_q16;
+    int32_t demand_trend_q16;
+    int32_t stall_trend_q16;
+    uint32_t pmu_high_edge_epoch;
+    uint32_t pmu_low_edge_epoch;
+
+    uint64_t mc_update_ns;
+    uint64_t mc_age_ns;
+    uint64_t mc_raw_bits;
+    uint32_t mc_activity_q16;
+    int32_t mc_trend_q16;
+    uint32_t mc_valid;
+    uint32_t mc_source_id;
+
+    uint64_t normalization_epoch;
+    uint64_t dropped_samples;
+    uint32_t flags;
+    uint32_t reserved0;
+    // progress-predictor gate published by the sampler
+    // (same layout as full_sched_signal_snapshot_v1); zero from older samplers.
+    uint64_t progress_frame_id;
+    uint64_t progress_update_ns;
+    uint64_t progress_pred_response_ns;
+    uint32_t progress_state;
+    uint32_t progress_reserved;
+    uint8_t reserved[272];
+} edgepace_signal_snapshot_v1;
+
+#define EDGEPACE_PROGRESS_TRACKING (1u << 0)
+#define EDGEPACE_PROGRESS_ALARM (1u << 1)
+#define EDGEPACE_PROGRESS_MODEL (1u << 2)
+
+// Single-writer ACTMON sidecar page. All timestamps use CLOCK_MONOTONIC.
+typedef struct edgepace_actmon_snapshot_v1 {
+    edgepace_abi_header header;
+    uint64_t sequence;
+    uint64_t update_ns;
+    uint64_t sample_index;
+    uint64_t actual_interval_ns;
+    uint64_t read_duration_ns;
+    uint64_t raw_activity;
+} edgepace_actmon_snapshot_v1;
+
+#ifdef __cplusplus
+static_assert(sizeof(edgepace_abi_header) == 16, "EdgePace ABI header size");
+static_assert(sizeof(edgepace_task_frame_v1) == 56, "EdgePace task frame size");
+static_assert(sizeof(edgepace_task_snapshot_v1) == 512, "EdgePace task page size");
+static_assert(sizeof(edgepace_request_state_v1) == 256, "EdgePace request page size");
+static_assert(sizeof(edgepace_signal_snapshot_v1) == 512, "EdgePace signal page size");
+static_assert(sizeof(edgepace_actmon_snapshot_v1) == 64, "EdgePace ACTMON page size");
+#endif
