diff --git a/external/edgepace_policy/edgepace_policy.cpp b/external/edgepace_policy/edgepace_policy.cpp
new file mode 100644
index 000000000..158c832a3
--- /dev/null
+++ b/external/edgepace_policy/edgepace_policy.cpp
@@ -0,0 +1,244 @@
+#include "edgepace_policy_abi.h"
+#include "edgepace_policy_engine.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <exception>
+
+namespace {
+
+using edgepace_policy_engine::completion;
+using edgepace_policy_engine::decision;
+using edgepace_policy_engine::mode;
+using edgepace_policy_engine::phase;
+using edgepace_policy_engine::runtime;
+
+phase from_abi_phase(uint32_t value) {
+    switch (value) {
+        case EDGEPACE_POLICY_PHASE_VISION: return phase::vision;
+        case EDGEPACE_POLICY_PHASE_PREFILL: return phase::prefill;
+        case EDGEPACE_POLICY_PHASE_DECODE: return phase::decode;
+        default: return phase::none;
+    }
+}
+
+void copy_text(char * destination, size_t capacity, const char * source) {
+    if (capacity == 0) return;
+    const char * value = source == nullptr ? "" : source;
+    size_t length = 0;
+    while (length + 1 < capacity && value[length] != '\0') ++length;
+    std::memcpy(destination, value, length);
+    destination[length] = '\0';
+}
+
+void fill_decision(const decision & input,
+                   edgepace_policy_decision_v1 & output) {
+    output = {};
+    output.abi_version = EDGEPACE_POLICY_ABI_VERSION;
+    // NATURAL = Bypass.  EdgePace bypasses outside foreground frames; the rho
+    // mode bypasses exactly when its risk is low, inside frames as well.
+    if (input.rho_mode ? input.bypass : std::strcmp(input.fg_phase, "low") == 0) {
+        output.flags |= EDGEPACE_POLICY_DECISION_NATURAL;
+    }
+    output.bytes = sizeof(output);
+    output.selected_mode = static_cast<uint32_t>(input.selected_mode);
+    output.outstanding_limit = input.outstanding_limit;
+    output.post_hold_quantum = input.post_hold_quantum ? 1u : 0u;
+    output.task_valid = input.task_valid ? 1u : 0u;
+    output.request_valid = input.request_valid ? 1u : 0u;
+    output.mc_valid = input.mc_valid ? 1u : 0u;
+    output.pmu_valid = input.pmu_valid ? 1u : 0u;
+    output.actmon_aux_valid = input.actmon_aux_valid ? 1u : 0u;
+    output.crosses_high_risk = input.crosses_high_risk ? 1u : 0u;
+    output.freshness_recoverable = input.freshness_recoverable ? 1u : 0u;
+    output.freshness_rescue = input.freshness_rescue ? 1u : 0u;
+    output.yield_requested = input.yield_requested ? 1u : 0u;
+    output.request_id = input.request_id;
+    output.frame_id = input.frame_id;
+    output.mc_activity = input.mc_activity;
+    output.next_quantum_ms = input.next_quantum_ms;
+    output.fg_deadline_remaining_ms = input.fg_deadline_remaining_ms;
+    output.fg_predicted_remaining_ms = input.fg_predicted_remaining_ms;
+    output.time_to_next_high_risk_ms = input.time_to_next_high_risk_ms;
+    output.foreground_elapsed_ms = input.foreground_elapsed_ms;
+    output.vlm_freshness_remaining_ms = input.vlm_freshness_remaining_ms;
+    output.estimated_remaining_service_ms = input.estimated_remaining_service_ms;
+    output.u_deadline = input.u_deadline;
+    output.u_phase = input.u_phase;
+    output.u_mc = input.u_mc;
+    output.pmu_demand = input.pmu_demand;
+    output.pmu_stall = input.pmu_stall;
+    output.actmon_aux = input.actmon_aux;
+    output.signal_age_ms = input.signal_age_ms;
+    output.online_risk = input.online_risk;
+    output.u_fresh = input.u_fresh;
+    output.c_quantum = input.c_quantum;
+    output.p_fg = input.p_fg;
+    output.p_vlm = input.p_vlm;
+    output.delta_p = input.delta_p;
+    output.safe_budget_ms = input.safe_budget_ms;
+    output.admission_budget_ms = input.admission_budget_ms;
+    output.total_guard_ms = input.total_guard_ms;
+    output.freshness_reserve_ms = input.freshness_reserve_ms;
+    copy_text(output.fg_phase, sizeof(output.fg_phase), input.fg_phase);
+    const char * reason = input.selected_mode == mode::hold
+        ? "g2_hold" : input.freshness_rescue ? "freshness_rescue"
+        : input.task_valid ? "g2_admit" : "no_foreground_task";
+    copy_text(output.reason, sizeof(output.reason), reason);
+}
+
+decision from_abi_decision(const edgepace_policy_decision_v1 & input) {
+    decision output{};
+    output.selected_mode = static_cast<mode>(input.selected_mode);
+    output.outstanding_limit = input.outstanding_limit;
+    output.post_hold_quantum = input.post_hold_quantum != 0;
+    output.task_valid = input.task_valid != 0;
+    output.request_valid = input.request_valid != 0;
+    output.mc_valid = input.mc_valid != 0;
+    output.pmu_valid = input.pmu_valid != 0;
+    output.actmon_aux_valid = input.actmon_aux_valid != 0;
+    output.crosses_high_risk = input.crosses_high_risk != 0;
+    output.freshness_recoverable = input.freshness_recoverable != 0;
+    output.freshness_rescue = input.freshness_rescue != 0;
+    output.yield_requested = input.yield_requested != 0;
+    output.request_id = input.request_id;
+    output.frame_id = input.frame_id;
+    output.mc_activity = input.mc_activity;
+    output.next_quantum_ms = input.next_quantum_ms;
+    output.fg_deadline_remaining_ms = input.fg_deadline_remaining_ms;
+    output.fg_predicted_remaining_ms = input.fg_predicted_remaining_ms;
+    output.time_to_next_high_risk_ms = input.time_to_next_high_risk_ms;
+    output.foreground_elapsed_ms = input.foreground_elapsed_ms;
+    output.vlm_freshness_remaining_ms = input.vlm_freshness_remaining_ms;
+    output.estimated_remaining_service_ms = input.estimated_remaining_service_ms;
+    output.u_deadline = input.u_deadline;
+    output.u_phase = input.u_phase;
+    output.u_mc = input.u_mc;
+    output.pmu_demand = input.pmu_demand;
+    output.pmu_stall = input.pmu_stall;
+    output.actmon_aux = input.actmon_aux;
+    output.signal_age_ms = input.signal_age_ms;
+    output.online_risk = input.online_risk;
+    output.u_fresh = input.u_fresh;
+    output.c_quantum = input.c_quantum;
+    output.p_fg = input.p_fg;
+    output.p_vlm = input.p_vlm;
+    output.delta_p = input.delta_p;
+    output.safe_budget_ms = input.safe_budget_ms;
+    output.admission_budget_ms = input.admission_budget_ms;
+    output.total_guard_ms = input.total_guard_ms;
+    output.freshness_reserve_ms = input.freshness_reserve_ms;
+
+    // The legacy engine stores this as a pointer.  Keep the pointed-to text
+    // alive for the synchronous event callback and its CSV logger.
+    static thread_local char phase_name[EDGEPACE_POLICY_PHASE_BYTES];
+    copy_text(phase_name, sizeof(phase_name), input.fg_phase);
+    output.fg_phase = phase_name;
+    return output;
+}
+
+bool valid_header(uint32_t version, uint16_t bytes, uint16_t expected) {
+    return version == EDGEPACE_POLICY_ABI_VERSION && bytes == expected;
+}
+
+runtime * as_runtime(void * handle) {
+    return static_cast<runtime *>(handle);
+}
+
+}  // namespace
+
+extern "C" void * edgepace_policy_create_v1(void) {
+    try {
+        setenv("EDGEPACE_CONTROL_REQUIRED", "1", 1);
+#ifdef EDGEPACE_POLICY_FORCED_POLICY
+        if (setenv("EDGEPACE_POLICY", EDGEPACE_POLICY_FORCED_POLICY, 1) != 0) {
+            return nullptr;
+        }
+#endif
+        return &runtime::instance();
+    } catch (...) {
+        return nullptr;
+    }
+}
+
+extern "C" void edgepace_policy_destroy_v1(void * handle) {
+    (void) handle;
+    // runtime::instance() owns its state and is destroyed when this DSO is
+    // unloaded.  The backend never deletes an object it did not allocate.
+}
+
+extern "C" int edgepace_policy_enabled_v1(void * handle) {
+    try {
+        return handle != nullptr && as_runtime(handle)->enabled() ? 1 : 0;
+    } catch (...) {
+        return -1;
+    }
+}
+
+extern "C" int edgepace_policy_active_request_v1(
+        void * handle, uint64_t * request_id) {
+    try {
+        if (handle == nullptr || request_id == nullptr) return -1;
+        return as_runtime(handle)->active_request(request_id) ? 1 : 0;
+    } catch (...) {
+        return -1;
+    }
+}
+
+extern "C" int edgepace_policy_evaluate_v1(
+        void * handle, const edgepace_policy_input_v1 * input,
+        edgepace_policy_decision_v1 * output) {
+    try {
+        if (handle == nullptr || input == nullptr || output == nullptr ||
+            !valid_header(input->abi_version, input->bytes, sizeof(*input))) {
+            return -1;
+        }
+        const phase value = from_abi_phase(input->phase);
+        if (value == phase::none || !std::isfinite(input->next_quantum_ms) ||
+            input->next_quantum_ms <= 0.0) {
+            return -1;
+        }
+        const decision result = as_runtime(handle)->evaluate(
+            value, input->next_quantum_ms, input->quantum_id);
+        fill_decision(result, *output);
+        return 0;
+    } catch (...) {
+        return -1;
+    }
+}
+
+extern "C" int edgepace_policy_on_event_v1(
+        void * handle, const edgepace_policy_event_v1 * event) {
+    try {
+        if (handle == nullptr || event == nullptr ||
+            !valid_header(event->abi_version, event->bytes, sizeof(*event)) ||
+            event->kind < EDGEPACE_POLICY_EVENT_ADMISSION ||
+            event->kind > EDGEPACE_POLICY_EVENT_COMPLETE) {
+            return -1;
+        }
+        completion value{};
+        value.graph_phase = from_abi_phase(event->phase);
+        value.quantum_id = event->quantum_id;
+        value.serial = event->serial;
+        value.graph_uid = event->graph_uid;
+        value.submit_ns = event->submit_ns;
+        value.predicted_ms = event->decision.next_quantum_ms;
+        value.post_hold_quantum = event->decision.post_hold_quantum != 0;
+        value.admitted = from_abi_decision(event->decision);
+        if (event->kind == EDGEPACE_POLICY_EVENT_ADMISSION) {
+            as_runtime(handle)->admission(
+                event->event, value.graph_phase, value.quantum_id,
+                value.graph_uid, value.admitted, event->outstanding,
+                event->limit);
+        } else if (event->kind == EDGEPACE_POLICY_EVENT_SUBMIT) {
+            as_runtime(handle)->submitted(value, event->outstanding);
+        } else {
+            as_runtime(handle)->completed(
+                value, event->outstanding, event->complete_ns);
+        }
+        return 0;
+    } catch (...) {
+        return -1;
+    }
+}
diff --git a/external/edgepace_policy/edgepace_policy_abi.h b/external/edgepace_policy/edgepace_policy_abi.h
new file mode 100644
index 000000000..5b52162f4
--- /dev/null
+++ b/external/edgepace_policy/edgepace_policy_abi.h
@@ -0,0 +1,138 @@
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define EDGEPACE_POLICY_ABI_VERSION 1u
+#define EDGEPACE_POLICY_REASON_BYTES 64u
+#define EDGEPACE_POLICY_PHASE_BYTES 16u
+#define EDGEPACE_POLICY_EVENT_BYTES 24u
+#define EDGEPACE_POLICY_DECISION_NATURAL 0x1u
+
+typedef enum edgepace_policy_phase_v1 {
+    EDGEPACE_POLICY_PHASE_NONE = 0,
+    EDGEPACE_POLICY_PHASE_VISION = 1,
+    EDGEPACE_POLICY_PHASE_PREFILL = 2,
+    EDGEPACE_POLICY_PHASE_DECODE = 3,
+} edgepace_policy_phase_v1;
+
+typedef enum edgepace_policy_mode_v1 {
+    EDGEPACE_POLICY_MODE_NORMAL = 0,
+    EDGEPACE_POLICY_MODE_PROTECTED = 1,
+    EDGEPACE_POLICY_MODE_HOLD = 2,
+} edgepace_policy_mode_v1;
+
+typedef enum edgepace_policy_event_kind_v1 {
+    EDGEPACE_POLICY_EVENT_ADMISSION = 1,
+    EDGEPACE_POLICY_EVENT_SUBMIT = 2,
+    EDGEPACE_POLICY_EVENT_COMPLETE = 3,
+} edgepace_policy_event_kind_v1;
+
+// Only POD fields cross the backend/policy boundary.  No ggml type is part of
+// this ABI, so the policy library can be rebuilt independently of llama.cpp.
+typedef struct edgepace_policy_input_v1 {
+    uint32_t abi_version;
+    uint16_t bytes;
+    uint16_t flags;
+    uint32_t phase;
+    int32_t quantum_id;
+    int32_t outstanding;
+    uint32_t reserved0;
+    uint64_t now_ns;
+    uint64_t execution_id;
+    double next_quantum_ms;
+} edgepace_policy_input_v1;
+
+typedef struct edgepace_policy_decision_v1 {
+    uint32_t abi_version;
+    uint16_t bytes;
+    uint16_t flags;
+    uint32_t selected_mode;
+    int32_t outstanding_limit;
+    uint32_t post_hold_quantum;
+    uint32_t task_valid;
+    uint32_t request_valid;
+    uint32_t mc_valid;
+    uint32_t pmu_valid;
+    uint32_t actmon_aux_valid;
+    uint32_t crosses_high_risk;
+    uint32_t freshness_recoverable;
+    uint32_t freshness_rescue;
+    uint32_t yield_requested;
+    uint64_t request_id;
+    uint64_t frame_id;
+    uint64_t mc_activity;
+    double next_quantum_ms;
+    double fg_deadline_remaining_ms;
+    double fg_predicted_remaining_ms;
+    double time_to_next_high_risk_ms;
+    double foreground_elapsed_ms;
+    double vlm_freshness_remaining_ms;
+    double estimated_remaining_service_ms;
+    double u_deadline;
+    double u_phase;
+    double u_mc;
+    double pmu_demand;
+    double pmu_stall;
+    double actmon_aux;
+    double signal_age_ms;
+    double online_risk;
+    double u_fresh;
+    double c_quantum;
+    double p_fg;
+    double p_vlm;
+    double delta_p;
+    double safe_budget_ms;
+    double admission_budget_ms;
+    double total_guard_ms;
+    double freshness_reserve_ms;
+    uint64_t pmu_sample_index;
+    char fg_phase[EDGEPACE_POLICY_PHASE_BYTES];
+    char reason[EDGEPACE_POLICY_REASON_BYTES];
+    uint8_t reserved[152];
+} edgepace_policy_decision_v1;
+
+typedef struct edgepace_policy_event_v1 {
+    uint32_t abi_version;
+    uint16_t bytes;
+    uint16_t kind;
+    uint32_t phase;
+    int32_t quantum_id;
+    int32_t outstanding;
+    int32_t limit;
+    uint32_t reserved0;
+    uint64_t graph_uid;
+    uint64_t serial;
+    uint64_t submit_ns;
+    uint64_t complete_ns;
+    edgepace_policy_decision_v1 decision;
+    char event[EDGEPACE_POLICY_EVENT_BYTES];
+} edgepace_policy_event_v1;
+
+typedef void * (*edgepace_policy_create_v1_fn)(void);
+typedef void (*edgepace_policy_destroy_v1_fn)(void * handle);
+typedef int (*edgepace_policy_enabled_v1_fn)(void * handle);
+typedef int (*edgepace_policy_active_request_v1_fn)(
+    void * handle, uint64_t * request_id);
+// Model boundaries, graph splits, and quantum timing remain backend-owned.
+typedef int (*edgepace_policy_evaluate_v1_fn)(
+    void * handle, const edgepace_policy_input_v1 * input,
+    edgepace_policy_decision_v1 * decision);
+typedef int (*edgepace_policy_event_v1_fn)(
+    void * handle, const edgepace_policy_event_v1 * event);
+
+#ifdef __cplusplus
+}
+#endif
+
+#ifdef __cplusplus
+static_assert(sizeof(edgepace_policy_input_v1) == 48,
+              "EdgePace policy input ABI size");
+static_assert(sizeof(edgepace_policy_decision_v1) == 512,
+              "EdgePace policy decision ABI size");
+static_assert(sizeof(edgepace_policy_event_v1) == 600,
+              "EdgePace policy event ABI size");
+#endif
diff --git a/external/edgepace_policy/edgepace_policy_engine.h b/external/edgepace_policy/edgepace_policy_engine.h
new file mode 100644
index 000000000..93daf40ea
--- /dev/null
+++ b/external/edgepace_policy/edgepace_policy_engine.h
@@ -0,0 +1,1572 @@
+#pragma once
+
+#include "conserve/slo_budget.h"
+#include "edgepace/abi.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace edgepace_policy_engine {
+
+enum class phase : uint32_t {
+    none = 0,
+    vision = 1,
+    prefill = 2,
+    decode = 3,
+};
+
+enum class mode : uint32_t {
+    normal = 0,
+    protected_mode = 1,
+    hold = 2,
+};
+
+struct decision {
+    mode selected_mode;
+    int outstanding_limit;
+    bool post_hold_quantum;
+    bool task_valid;
+    bool request_valid;
+    bool mc_valid;
+    bool pmu_valid;
+    bool actmon_aux_valid;
+    bool crosses_high_risk;
+    bool freshness_recoverable;
+    bool freshness_rescue;
+    uint64_t request_id;
+    uint64_t frame_id;
+    uint64_t mc_activity;
+    double next_quantum_ms;
+    double fg_deadline_remaining_ms;
+    double fg_predicted_remaining_ms;
+    double time_to_next_high_risk_ms;
+    double foreground_elapsed_ms;
+    double vlm_freshness_remaining_ms;
+    double estimated_remaining_service_ms;
+    double u_deadline;
+    double u_phase;
+    double u_mc;
+    double pmu_demand;
+    double pmu_stall;
+    double actmon_aux;
+    double signal_age_ms;
+    double online_risk;
+    bool posterior_quantum_high_risk;
+    double frame_service_used_ms;
+    double frame_service_budget_ms;
+    double frame_early_service_used_ms;
+    double frame_early_service_budget_ms;
+    double posterior_frame_charge_used_ms;
+    double posterior_frame_charge_budget_ms;
+    double u_fresh;
+    double c_quantum;
+    double p_fg;
+    double p_vlm;
+    double delta_p;
+    double safe_budget_ms;
+    double admission_budget_ms;
+    double total_guard_ms;
+    double freshness_reserve_ms;
+    bool yield_requested;
+    const char * fg_phase;
+    // sampler progress-predictor state
+    bool progress_valid;        // signal page carries a predictor state
+    bool progress_alarm;        // gate rule fired for progress_frame_id
+    uint64_t progress_frame_id;
+    double progress_pred_response_ms;
+    // paper §3.3 (rho) mode
+    bool rho_mode;                     // the decision came from evaluate_rho
+    bool bypass;                       // low risk: ordinary submission (NATURAL)
+    double fg_since_release_ms;        // t - r_fg of the active job
+    double fg_recent_response_ms;      // R_fg estimate: max(EWMA, last response)
+};
+
+struct completion {
+    phase graph_phase;
+    int quantum_id;
+    uint64_t serial;
+    uint64_t graph_uid;
+    uint64_t submit_ns;
+    double predicted_ms;
+    bool post_hold_quantum;
+    decision admitted;
+};
+
+struct rt_state {
+    std::atomic<uint64_t> sequence{0};
+    std::atomic<int> fg_phase{static_cast<int>(conserve::fg_phase::low)};
+    std::atomic<int64_t> deadline_remaining_us{0};
+    std::atomic<int64_t> predicted_fg_remaining_us{0};
+    std::atomic<int64_t> time_to_next_risk_us{0};
+    std::atomic<float> mc_pressure{0.0f};
+    std::atomic<int64_t> freshness_remaining_us{0};
+    std::atomic<int64_t> estimated_remaining_service_us{0};
+    std::atomic<int64_t> current_safe_budget_us{0};
+    std::atomic<int64_t> admission_budget_us{0};
+    std::atomic<int64_t> total_guard_us{0};
+    std::atomic<int64_t> freshness_reserve_us{0};
+    std::atomic<bool> yield_requested{false};
+    std::atomic<bool> task_valid{false};
+    std::atomic<bool> request_valid{false};
+    std::atomic<bool> mc_valid{false};
+    std::atomic<uint64_t> request_id{0};
+    std::atomic<uint64_t> mc_activity{0};
+};
+
+inline uint64_t monotonic_ns() {
+    timespec value{};
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    return static_cast<uint64_t>(value.tv_sec) * UINT64_C(1000000000) +
+           static_cast<uint64_t>(value.tv_nsec);
+}
+
+inline const char * phase_name(phase value) {
+    switch (value) {
+        case phase::vision: return "vision";
+        case phase::prefill: return "prefill";
+        case phase::decode: return "decode";
+        default: return "none";
+    }
+}
+
+inline const char * mode_name(mode value) {
+    switch (value) {
+        case mode::normal: return "NORMAL";
+        case mode::protected_mode: return "PROTECTED";
+        case mode::hold: return "HOLD";
+    }
+    return "NORMAL";
+}
+
+inline double clamp01(double value) {
+    return std::min(1.0, std::max(0.0, value));
+}
+
+inline double urgency(double value, double warning, double critical = 0.0) {
+    if (warning <= critical) return value <= critical ? 1.0 : 0.0;
+    return clamp01((warning - value) / (warning - critical));
+}
+
+inline double ns_to_ms_signed(int64_t value) {
+    return static_cast<double>(value) / 1e6;
+}
+
+inline double env_double(const char * name, double fallback) {
+    const char * text = std::getenv(name);
+    if (text == nullptr || *text == '\0') return fallback;
+    char * end = nullptr;
+    errno = 0;
+    const double value = std::strtod(text, &end);
+    return errno == 0 && end != text && *end == '\0' && std::isfinite(value)
+        ? value : fallback;
+}
+
+inline int env_int(const char * name, int fallback) {
+    const char * text = std::getenv(name);
+    if (text == nullptr || *text == '\0') return fallback;
+    char * end = nullptr;
+    errno = 0;
+    const long value = std::strtol(text, &end, 10);
+    return errno == 0 && end != text && *end == '\0' && value >= 0 &&
+                   value <= std::numeric_limits<int>::max()
+        ? static_cast<int>(value) : fallback;
+}
+
+inline bool env_bool(const char * name, bool fallback) {
+    return env_int(name, fallback ? 1 : 0) != 0;
+}
+
+inline std::vector<uint64_t> env_u64_list(const char * name) {
+    std::vector<uint64_t> values;
+    const char * cursor = std::getenv(name);
+    if (cursor == nullptr || *cursor == '\0') return values;
+    while (*cursor != '\0') {
+        char * end = nullptr;
+        errno = 0;
+        const unsigned long long value = std::strtoull(cursor, &end, 10);
+        if (errno != 0 || end == cursor) return {};
+        values.push_back(static_cast<uint64_t>(value));
+        if (*end == '\0') break;
+        if (*end != ',') return {};
+        cursor = end + 1;
+    }
+    std::sort(values.begin(), values.end());
+    values.erase(std::unique(values.begin(), values.end()), values.end());
+    return values;
+}
+
+class mapped_pages {
+public:
+    mapped_pages() {
+        set_path(task_, "EDGEPACE_TASK_PAGE");
+        set_path(request_, "EDGEPACE_REQUEST_PAGE");
+        set_path(signal_, "EDGEPACE_SIGNAL_PAGE");
+        set_path(actmon_, "EDGEPACE_ACTMON_PAGE");
+    }
+
+    mapped_pages(const mapped_pages &) = delete;
+    mapped_pages & operator=(const mapped_pages &) = delete;
+
+    ~mapped_pages() {
+        close_page(task_);
+        close_page(request_);
+        close_page(signal_);
+        close_page(actmon_);
+    }
+
+    bool task(edgepace_task_snapshot_v1 & output) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return read(task_, output, EDGEPACE_FULL_TASK_MAGIC);
+    }
+
+    bool request(edgepace_request_state_v1 & output) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return read(request_, output, EDGEPACE_FULL_REQUEST_MAGIC);
+    }
+
+    bool signal(edgepace_signal_snapshot_v1 & output) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return read(signal_, output, EDGEPACE_FULL_SIGNAL_MAGIC);
+    }
+
+    bool actmon(edgepace_actmon_snapshot_v1 & output) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return read(actmon_, output, EDGEPACE_ACTMON_MAGIC);
+    }
+
+private:
+    struct page_mapping {
+        std::string path;
+        int fd = -1;
+        void * address = nullptr;
+        size_t bytes = 0;
+    };
+
+    static void set_path(page_mapping & page, const char * name) {
+        const char * value = std::getenv(name);
+        if (value != nullptr) page.path = value;
+    }
+
+    static void close_page(page_mapping & page) {
+        if (page.address != nullptr) ::munmap(page.address, page.bytes);
+        if (page.fd >= 0) ::close(page.fd);
+        page.address = nullptr;
+        page.fd = -1;
+    }
+
+    template <typename Page>
+    static bool open_page(page_mapping & page) {
+        if (page.address != nullptr) return true;
+        if (page.path.empty()) return false;
+        page.fd = ::open(page.path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (page.fd < 0) return false;
+        page.bytes = sizeof(Page);
+        page.address = ::mmap(nullptr, page.bytes, PROT_READ, MAP_SHARED,
+                              page.fd, 0);
+        if (page.address == MAP_FAILED) {
+            page.address = nullptr;
+            ::close(page.fd);
+            page.fd = -1;
+            return false;
+        }
+        return true;
+    }
+
+    template <typename Page>
+    static bool read(page_mapping & mapping, Page & output, uint32_t magic) {
+        if (!open_page<Page>(mapping)) return false;
+        const auto * page = static_cast<const Page *>(mapping.address);
+        for (int attempt = 0; attempt < 4; ++attempt) {
+            const uint64_t before =
+                __atomic_load_n(&page->sequence, __ATOMIC_ACQUIRE);
+            if (before & 1U) continue;
+            std::memcpy(&output, page, sizeof(output));
+            __atomic_thread_fence(__ATOMIC_ACQUIRE);
+            const uint64_t after =
+                __atomic_load_n(&page->sequence, __ATOMIC_ACQUIRE);
+            if (before == after && !(after & 1U) &&
+                output.header.magic == magic &&
+                output.header.version == EDGEPACE_ABI_VERSION &&
+                output.header.bytes == sizeof(Page)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    page_mapping task_;
+    page_mapping request_;
+    page_mapping signal_;
+    page_mapping actmon_;
+    std::mutex mutex_;
+};
+
+class runtime {
+public:
+    static runtime & instance() {
+        static runtime value;
+        return value;
+    }
+
+    runtime(const runtime &) = delete;
+    runtime & operator=(const runtime &) = delete;
+
+    ~runtime() {
+        monitor_running_.store(false, std::memory_order_relaxed);
+        if (monitor_thread_.joinable()) monitor_thread_.join();
+    }
+
+    bool enabled() const {
+        return policy_ != "off" && policy_ != "unmanaged";
+    }
+
+    bool active_request(uint64_t * request_id = nullptr) {
+        if (request_id != nullptr) *request_id = 0;
+        if (policy_ == "profile_static") {
+            if (request_id != nullptr) *request_id = 1;
+            return true;
+        }
+        edgepace_request_state_v1 request{};
+        const bool active = pages_.request(request) && request.running != 0 &&
+                            request.request_id != 0;
+        if (active && request_id != nullptr) *request_id = request.request_id;
+        return active;
+    }
+
+    uint64_t next_serial() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return ++serial_;
+    }
+
+    uint64_t next_execution_id() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return ++execution_id_;
+    }
+
+    decision evaluate(phase graph_phase, double next_quantum_ms,
+                      int quantum_id = -1) {
+        if (policy_ == "slo_budget") {
+            return evaluate_slo_budget(graph_phase, next_quantum_ms);
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        const uint64_t now = monotonic_ns();
+        decision result{};
+        result.next_quantum_ms = next_quantum_ms;
+        if (policy_ == "profile_static") {
+            result.request_id = 1;
+            result.fg_phase = "profile";
+            result.selected_mode = mode::normal;
+            result.outstanding_limit = 1;
+            return result;
+        }
+
+        edgepace_request_state_v1 request{};
+        result.request_valid = pages_.request(request) && request.running != 0;
+        if (result.request_valid) {
+            result.request_id = request.request_id;
+            reset_request_if_needed(request.request_id);
+            result.vlm_freshness_remaining_ms = ns_to_ms_signed(
+                static_cast<int64_t>(request.freshness_deadline_ns) -
+                static_cast<int64_t>(now));
+        } else {
+            result.request_id = current_request_id_;
+            result.vlm_freshness_remaining_ms = freshness_ttl_ms_;
+        }
+        result.estimated_remaining_service_ms =
+            std::max(next_quantum_ms, total_service_ms_ - completed_service_ms_);
+
+        edgepace_task_snapshot_v1 task{};
+        result.task_valid = pages_.task(task);
+        if (result.task_valid && task.second_odom_deadline_ns != 0 &&
+            now > task.second_odom_deadline_ns) {
+            result.task_valid = false;
+        }
+        fill_fg_state(task, result.task_valid, now, result);
+        if (emit_tracking_phase_ && result.task_valid &&
+            std::strcmp(result.fg_phase, "low") == 0 &&
+            result.time_to_next_high_risk_ms >= 0.0 &&
+            result.time_to_next_high_risk_ms <= phase_warning_ms_) {
+            result.fg_phase = "tracking";
+        }
+
+        edgepace_actmon_snapshot_v1 actmon{};
+        if (pages_.actmon(actmon) && actmon.header.flags != 0 &&
+            now >= actmon.update_ns &&
+            now - actmon.update_ns <= maximum_mc_age_ns_) {
+            result.mc_valid = true;
+            result.mc_activity = actmon.raw_activity;
+            result.u_mc = clamp01(
+                (static_cast<double>(actmon.raw_activity) - mc_low_) /
+                (mc_high_ - mc_low_));
+        }
+
+        edgepace_signal_snapshot_v1 signal{};
+        if (pages_.signal(signal) && now >= signal.update_ns &&
+            now - signal.update_ns <= maximum_signal_age_ns_) {
+            result.signal_age_ms = static_cast<double>(now - signal.update_ns) / 1e6;
+            if (signal.pmu_valid != 0 && signal.pmu_counter_reset == 0 &&
+                signal.flags == 0) {
+                result.pmu_valid = true;
+                const uint32_t demand = signal.demand_ewma_q16 != 0
+                    ? signal.demand_ewma_q16 : signal.demand_pressure_q16;
+                const uint32_t stall = signal.stall_ewma_q16 != 0
+                    ? signal.stall_ewma_q16 : signal.stall_pressure_q16;
+                result.pmu_demand = clamp01(static_cast<double>(demand) / 65535.0);
+                result.pmu_stall = clamp01(static_cast<double>(stall) / 65535.0);
+            }
+            if (signal.progress_update_ns != 0 &&
+                (signal.progress_state & EDGEPACE_PROGRESS_MODEL) != 0) {
+                result.progress_valid = true;
+                result.progress_alarm = (signal.progress_state & EDGEPACE_PROGRESS_ALARM) != 0;
+                result.progress_frame_id = signal.progress_frame_id;
+                result.progress_pred_response_ms =
+                    static_cast<double>(signal.progress_pred_response_ns) / 1e6;
+            }
+            if (signal.mc_valid != 0) {
+                result.actmon_aux_valid = true;
+                result.actmon_aux = clamp01(
+                    static_cast<double>(signal.mc_activity_q16) / 65535.0);
+                if (!result.mc_valid) {
+                    result.mc_valid = true;
+                    result.mc_activity = signal.mc_activity_q16;
+                    result.u_mc = result.actmon_aux;
+                }
+            }
+        }
+
+        const double fg_laxity = result.fg_deadline_remaining_ms -
+                                   result.fg_predicted_remaining_ms;
+        result.u_deadline = urgency(fg_laxity, deadline_warning_ms_);
+        const double phase_base = std::strcmp(result.fg_phase, "fg_active") == 0
+            ? 1.0 : std::strcmp(result.fg_phase, "tracking") == 0 ? 0.5 : 0.0;
+        result.u_phase = std::max(
+            phase_base,
+            clamp01(1.0 - std::max(0.0, result.time_to_next_high_risk_ms) /
+                              phase_warning_ms_));
+        const double freshness_slack = result.vlm_freshness_remaining_ms -
+                                       result.estimated_remaining_service_ms;
+        const bool freshness_expired =
+            result.request_valid && result.vlm_freshness_remaining_ms <= 0.0;
+        result.u_fresh = drop_expired_freshness_urgency_ && freshness_expired
+            ? 0.0 : urgency(freshness_slack, freshness_warning_ms_);
+        result.c_quantum = clamp01(next_quantum_ms / quantum_reference_ms_);
+        result.crosses_high_risk = next_quantum_ms + temporal_guard_ms_ >
+                                   std::max(0.0, result.time_to_next_high_risk_ms);
+
+        if (policy_ == "posterior") {
+            return evaluate_posterior(graph_phase, quantum_id, result);
+        }
+        if (policy_ == "frame_oracle") {
+            return evaluate_frame_oracle(graph_phase, result);
+        }
+        if (policy_ == "pmu_online" || policy_ == "adaptive_slo_online") {
+            return evaluate_pmu_online(graph_phase, result);
+        }
+
+        if (policy_ == "chunked") {
+            result.selected_mode = mode::normal;
+            result.outstanding_limit = 1;
+            return result;
+        }
+        if (policy_ == "fixed") {
+            result.selected_mode = std::strcmp(result.fg_phase, "fg_active") == 0
+                ? mode::hold : mode::normal;
+            result.outstanding_limit = result.selected_mode == mode::hold ? 0 : 1;
+            return result;
+        }
+        if (policy_ == "deadline") {
+            result.selected_mode = fg_laxity <= deadline_only_warning_ms_
+                ? mode::hold : mode::normal;
+            result.outstanding_limit = result.selected_mode == mode::hold ? 0 : 1;
+            return result;
+        }
+
+        result.p_fg = w_deadline_ * result.u_deadline +
+                        w_phase_ * result.u_phase +
+                        (result.mc_valid ? w_mc_ * result.u_mc : 0.0) +
+                        (result.crosses_high_risk ? w_cross_ : 0.0);
+        result.p_vlm = w_fresh_ * result.u_fresh -
+                       w_runtime_ * result.c_quantum;
+        result.delta_p = result.p_fg - result.p_vlm;
+        if (result.delta_p >= theta_high_) {
+            result.selected_mode = mode::hold;
+        } else if (result.delta_p >= theta_low_) {
+            result.selected_mode = mode::protected_mode;
+        } else {
+            result.selected_mode = mode::normal;
+        }
+        const double rescue_budget_ms = next_quantum_ms + temporal_guard_ms_;
+        result.freshness_recoverable = result.request_valid &&
+            result.vlm_freshness_remaining_ms > 0.0 && freshness_slack >= 0.0;
+        result.freshness_rescue = feasible_freshness_rescue_ &&
+            result.u_fresh > 0.0 && result.freshness_recoverable &&
+            fg_laxity >= rescue_budget_ms &&
+            result.time_to_next_high_risk_ms >= rescue_budget_ms;
+        if (result.freshness_rescue) {
+            result.selected_mode = mode::protected_mode;
+        }
+        if (!result.mc_valid && result.selected_mode == mode::normal) {
+            result.selected_mode = mode::protected_mode;
+        }
+
+        if (result.selected_mode == mode::hold) {
+            post_hold_required_ = true;
+            post_hold_pending_ = false;
+        } else if (post_hold_required_) {
+            result.selected_mode = mode::protected_mode;
+            result.post_hold_quantum = true;
+        }
+        result.outstanding_limit = result.selected_mode == mode::normal
+            ? normal_outstanding_limit_ :
+            result.selected_mode == mode::protected_mode
+                ? protected_outstanding_limit_ : 0;
+        (void) graph_phase;
+        return result;
+    }
+
+    void submitted(const completion & value, int outstanding_after) {
+        if (policy_ == "slo_budget") {
+            const uint64_t runtime_ns = static_cast<uint64_t>(
+                std::max(0.0, value.predicted_ms) * 1e6);
+            active_safepoint_deadline_ns_.store(
+                value.submit_ns + runtime_ns, std::memory_order_relaxed);
+        }
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (value.post_hold_quantum) post_hold_pending_ = true;
+            outstanding_service_ms_ += value.predicted_ms;
+        }
+        log("submit", value, outstanding_after, value.admitted.outstanding_limit,
+            value.submit_ns, 0);
+    }
+
+    void completed(const completion & value, int outstanding_after,
+                   uint64_t complete_ns) {
+        if (policy_ == "slo_budget") {
+            active_safepoint_deadline_ns_.store(0, std::memory_order_relaxed);
+        }
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            outstanding_service_ms_ = std::max(
+                0.0, outstanding_service_ms_ - value.predicted_ms);
+            completed_service_ms_ += value.predicted_ms;
+            if (value.post_hold_quantum) {
+                post_hold_pending_ = false;
+                post_hold_required_ = false;
+            }
+        }
+        log("complete", value, outstanding_after,
+            value.admitted.outstanding_limit, value.submit_ns, complete_ns);
+    }
+
+    void admission(const char * event, phase graph_phase, int quantum_id,
+                   uint64_t graph_uid, const decision & admitted,
+                   int outstanding, int limit) {
+        completion value{};
+        value.graph_phase = graph_phase;
+        value.quantum_id = quantum_id;
+        value.graph_uid = graph_uid;
+        value.predicted_ms = admitted.next_quantum_ms;
+        value.post_hold_quantum = admitted.post_hold_quantum;
+        value.admitted = admitted;
+        log(event, value, outstanding, limit, 0, 0);
+    }
+
+    const std::string & policy() const { return policy_; }
+
+private:
+    bool apply_active_frame_budget(decision & result, phase graph_phase,
+                                   bool foreground_active, bool admit) {
+        if (!foreground_active || result.frame_id == 0) return admit;
+        if (result.frame_id != last_service_budget_frame_id_) {
+            last_service_budget_frame_id_ = result.frame_id;
+            frame_admitted_service_ms_ = 0.0;
+            frame_prefill_early_admitted_service_ms_ = 0.0;
+            frame_decode_early_admitted_service_ms_ = 0.0;
+        }
+
+        double & early_used = graph_phase == phase::decode
+            ? frame_decode_early_admitted_service_ms_
+            : frame_prefill_early_admitted_service_ms_;
+        const double early_budget = graph_phase == phase::decode
+            ? active_decode_early_budget_ms_
+            : active_prefill_early_budget_ms_;
+        result.frame_service_used_ms = frame_admitted_service_ms_;
+        result.frame_service_budget_ms = active_frame_budget_ms_;
+        result.frame_early_service_used_ms = early_used;
+        result.frame_early_service_budget_ms = early_budget;
+        if (!admit) return false;
+
+        const bool early = result.foreground_elapsed_ms < active_early_window_end_ms_;
+        const bool frame_fits = active_frame_budget_ms_ < 0.0 ||
+            frame_admitted_service_ms_ + result.next_quantum_ms <=
+                active_frame_budget_ms_ + 1e-9;
+        const bool early_fits = !early || early_budget < 0.0 ||
+            early_used + result.next_quantum_ms <= early_budget + 1e-9;
+        if (!frame_fits || !early_fits) return false;
+
+        frame_admitted_service_ms_ += result.next_quantum_ms;
+        if (early) early_used += result.next_quantum_ms;
+        result.frame_service_used_ms = frame_admitted_service_ms_;
+        result.frame_early_service_used_ms = early_used;
+        return true;
+    }
+
+    bool apply_posterior_frame_charge_budget(decision & result, phase graph_phase,
+                                             bool foreground_active, bool admit) {
+        if (!foreground_active || result.frame_id == 0 ||
+            posterior_frame_charge_budget_ms_ < 0.0) {
+            return admit;
+        }
+        if (result.frame_id != last_posterior_charge_frame_id_) {
+            last_posterior_charge_frame_id_ = result.frame_id;
+            posterior_frame_admitted_charge_ms_ = 0.0;
+        }
+        result.posterior_frame_charge_used_ms = posterior_frame_admitted_charge_ms_;
+        result.posterior_frame_charge_budget_ms = posterior_frame_charge_budget_ms_;
+        if (!admit) return false;
+
+        const double cap_ms = graph_phase == phase::decode
+            ? posterior_decode_charge_cap_ms_ : posterior_prefill_charge_cap_ms_;
+        const double charge_ms = cap_ms >= 0.0
+            ? std::min(result.next_quantum_ms, cap_ms) : result.next_quantum_ms;
+        if (posterior_frame_admitted_charge_ms_ + charge_ms >
+            posterior_frame_charge_budget_ms_ + 1e-9) {
+            return false;
+        }
+        posterior_frame_admitted_charge_ms_ += charge_ms;
+        result.posterior_frame_charge_used_ms = posterior_frame_admitted_charge_ms_;
+        return true;
+    }
+
+    decision evaluate_posterior(phase graph_phase, int quantum_id,
+                                decision result) {
+        const bool foreground_active =
+            std::strcmp(result.fg_phase, "fg_active") == 0;
+        const double laxity = result.fg_deadline_remaining_ms -
+                              result.fg_predicted_remaining_ms;
+        bool admit = !result.task_valid;
+
+        const double risk_begin_ms = graph_phase == phase::decode
+            ? posterior_decode_risk_begin_ms_ : posterior_prefill_risk_begin_ms_;
+        const double risk_end_ms = graph_phase == phase::decode
+            ? posterior_decode_risk_end_ms_ : posterior_prefill_risk_end_ms_;
+        const double deadline_charge_cap_ms = graph_phase == phase::decode
+            ? posterior_decode_charge_cap_ms_
+            : posterior_prefill_charge_cap_ms_;
+        const int high_risk_begin_quantum = graph_phase == phase::decode
+            ? posterior_decode_high_risk_begin_quantum_
+            : posterior_prefill_high_risk_begin_quantum_;
+        const int high_risk_end_quantum = graph_phase == phase::decode
+            ? posterior_decode_high_risk_end_quantum_
+            : posterior_prefill_high_risk_end_quantum_;
+        const double low_risk_charge_ms = graph_phase == phase::decode
+            ? posterior_decode_low_risk_charge_ms_
+            : posterior_prefill_low_risk_charge_ms_;
+        const bool quantum_risk_enabled = high_risk_begin_quantum >= 0 &&
+            high_risk_end_quantum >= high_risk_begin_quantum;
+        result.posterior_quantum_high_risk = !quantum_risk_enabled ||
+            (quantum_id >= high_risk_begin_quantum &&
+             quantum_id <= high_risk_end_quantum);
+        bool count_overlap_quantum = false;
+        if (result.task_valid && foreground_active) {
+            if (result.frame_id != last_posterior_overlap_frame_id_) {
+                last_posterior_overlap_frame_id_ = result.frame_id;
+                posterior_prefill_overlap_quanta_ = 0;
+                posterior_decode_overlap_quanta_ = 0;
+            }
+            const double start = result.foreground_elapsed_ms;
+            const double queued_quantum_ms =
+                outstanding_service_ms_ + result.next_quantum_ms;
+            const double finish = start + queued_quantum_ms + posterior_gap_guard_ms_;
+            const double deadline_charge_ms = deadline_charge_cap_ms >= 0.0
+                ? std::min(queued_quantum_ms, deadline_charge_cap_ms)
+                : queued_quantum_ms;
+            const bool late_fit = deadline_charge_cap_ms >= 0.0
+                ? deadline_charge_ms + posterior_gap_guard_ms_ <= laxity
+                : queued_quantum_ms + posterior_gap_guard_ms_ <=
+                    result.fg_deadline_remaining_ms;
+            result.safe_budget_ms = laxity;
+            result.admission_budget_ms = deadline_charge_ms;
+            if (!result.posterior_quantum_high_risk &&
+                low_risk_charge_ms >= 0.0) {
+                const double low_risk_charge =
+                    std::min(queued_quantum_ms, low_risk_charge_ms);
+                result.admission_budget_ms = low_risk_charge;
+                admit = low_risk_charge + posterior_gap_guard_ms_ <= laxity;
+            } else {
+                admit = finish <= risk_begin_ms ||
+                        (start >= risk_end_ms && late_fit);
+            }
+            int & overlap_quanta = graph_phase == phase::decode
+                ? posterior_decode_overlap_quanta_
+                : posterior_prefill_overlap_quanta_;
+            const int overlap_limit = graph_phase == phase::decode
+                ? posterior_decode_overlap_limit_
+                : posterior_prefill_overlap_limit_;
+            if (overlap_quanta >= overlap_limit ||
+                laxity <= posterior_min_laxity_ms_) {
+                admit = false;
+            }
+            count_overlap_quantum = admit;
+        } else if (result.task_valid) {
+            const double safe_horizon_ms =
+                result.time_to_next_high_risk_ms + risk_begin_ms;
+            admit = safe_horizon_ms >=
+                    outstanding_service_ms_ + result.next_quantum_ms +
+                    posterior_gap_guard_ms_;
+        }
+
+        admit = apply_active_frame_budget(result, graph_phase, foreground_active, admit);
+        admit = apply_posterior_frame_charge_budget(
+            result, graph_phase, foreground_active, admit);
+        if (admit && count_overlap_quantum) {
+            int & overlap_quanta = graph_phase == phase::decode
+                ? posterior_decode_overlap_quanta_
+                : posterior_prefill_overlap_quanta_;
+            ++overlap_quanta;
+        }
+        result.online_risk = urgency(laxity, deadline_warning_ms_);
+        result.p_fg = result.online_risk;
+        result.p_vlm = result.u_fresh;
+        result.delta_p = result.p_fg - result.p_vlm;
+        const bool pipeline_quantum = admit &&
+            (graph_phase == phase::prefill || graph_phase == phase::decode);
+        result.selected_mode = !admit ? mode::hold :
+            pipeline_quantum ? mode::normal : mode::protected_mode;
+        result.outstanding_limit = !admit ? 0 :
+            pipeline_quantum ? (foreground_active ? 1 : 2) : 1;
+        return result;
+    }
+
+    // paper §3.3 / Algorithm 1.  rho = wD*D + wS*S + wU*U(t) with
+    // U = C(1 - L_fg / H), L_fg = (d_fg - t) - W_fg and F = 1{L_fresh <= 0};
+    // F -> Admit, else rho < theta_low -> Bypass, < theta_high -> Admit, else
+    // Hold (the backend rechecks every 1 ms while held).  W_fg, the time the
+    // active job still needs, is the sampler's progress prediction once it has
+    // one for this frame, else the historical estimate R_fg - (t - r_fg).
+    decision evaluate_rho(phase graph_phase, decision result) {
+        const bool foreground_active =
+            std::strcmp(result.fg_phase, "fg_active") == 0;
+        result.rho_mode = true;
+        double urgency = 0.0;
+        if (result.task_valid && foreground_active) {
+            double remaining = std::max(
+                0.0, result.fg_recent_response_ms - result.fg_since_release_ms);
+            if (result.progress_valid && result.progress_frame_id == result.frame_id &&
+                result.progress_pred_response_ms > 0.0) {
+                remaining = std::max(
+                    0.0, result.progress_pred_response_ms - result.fg_since_release_ms);
+            }
+            // L_fg = (d - t) - (1 + k) W_fg — with the LLM running, the foreground's
+            // remaining work takes k longer (k = EDGEPACE_RHO_INTERFERENCE, measured by the
+            // profile; 0 is §3.3's L_fg = (d - t) - W_fg)
+            const double laxity = result.fg_deadline_remaining_ms - (1.0 + rho_interference_) * remaining;
+            urgency = clamp01(1.0 - laxity / rho_horizon_ms_);
+            result.safe_budget_ms = laxity;          // L_fg, logged
+            result.admission_budget_ms = remaining;  // W_fg, logged
+        }
+        // invalid or stale PMU samples must not look like low pressure (§3.2)
+        const double demand = result.pmu_valid ? result.pmu_demand : 1.0;
+        const double stall = result.pmu_valid ? result.pmu_stall : 1.0;
+        result.u_deadline = urgency;
+        result.online_risk = rho_w_demand_ * demand + rho_w_stall_ * stall +
+                             rho_w_urgency_ * urgency;
+        result.p_fg = result.online_risk;
+        result.delta_p = result.online_risk;
+        const double fresh_budget =
+            result.vlm_freshness_remaining_ms - result.estimated_remaining_service_ms;
+        result.freshness_rescue = result.request_valid && fresh_budget <= 0.0;
+
+        const bool pipeline_quantum =
+            graph_phase == phase::prefill || graph_phase == phase::decode;
+        if (result.freshness_rescue || (result.online_risk >= rho_theta_low_ &&
+                                        result.online_risk < rho_theta_high_)) {
+            result.selected_mode = pipeline_quantum ? mode::normal : mode::protected_mode;
+            result.outstanding_limit = 1;                       // Admit
+        } else if (result.online_risk < rho_theta_low_) {
+            result.bypass = true;                               // Bypass
+            result.selected_mode = mode::normal;
+            result.outstanding_limit = 2;
+        } else {
+            result.selected_mode = mode::hold;                  // Hold
+            result.outstanding_limit = 0;
+        }
+        return result;
+    }
+
+    decision evaluate_pmu_online(phase graph_phase, decision result) {
+        if (online_rho_) return evaluate_rho(graph_phase, result);
+        const bool foreground_active =
+            std::strcmp(result.fg_phase, "fg_active") == 0;
+        const double laxity = result.fg_deadline_remaining_ms -
+                              result.fg_predicted_remaining_ms;
+        const double aux = result.actmon_aux_valid ? result.actmon_aux : 0.0;
+        result.online_risk =
+            online_w_deadline_ * result.u_deadline +
+            online_w_demand_ * result.pmu_demand +
+            online_w_stall_ * result.pmu_stall +
+            online_w_actmon_ * aux -
+            online_w_freshness_ * result.u_fresh;
+        result.p_fg = result.online_risk;
+        result.p_vlm = online_w_freshness_ * result.u_fresh;
+        result.delta_p = result.online_risk;
+
+        bool admit = !result.task_valid;
+        bool count_overlap_quantum = false;
+        const double queued_quantum_ms =
+            outstanding_service_ms_ + result.next_quantum_ms;
+        if (result.task_valid && foreground_active) {
+            if (result.frame_id != last_online_overlap_frame_id_) {
+                last_online_overlap_frame_id_ = result.frame_id;
+                online_overlap_quanta_ = 0;
+            }
+            if (online_effect_gate_) {
+                // with the progress gate the PMU condition is the
+                // sampler's per-frame prediction (no alarm for this frame)
+                // instead of the demand/stall levels.
+                const bool pressure_safe = online_progress_gate_
+                    ? result.pmu_valid && result.progress_valid &&
+                      !(result.progress_alarm && result.progress_frame_id == result.frame_id)
+                    : result.pmu_valid &&
+                      result.pmu_demand <= online_demand_safe_max_ &&
+                      result.pmu_stall <= online_stall_safe_max_;
+                const double deadline_charge_ms = std::min(
+                    queued_quantum_ms, online_deadline_charge_cap_ms_);
+                const bool deadline_fit =
+                    laxity >= deadline_charge_ms + online_gap_guard_ms_;
+                const bool freshness_rescue =
+                    result.u_fresh >= online_fresh_rescue_threshold_ &&
+                    result.pmu_valid &&
+                    result.pmu_stall <= online_fresh_stall_safe_max_ &&
+                    laxity > 1.0;
+                admit = (pressure_safe && deadline_fit) || freshness_rescue;
+                count_overlap_quantum = admit;
+            } else {
+                int quota = 0;
+                if (result.pmu_valid) {
+                    if (result.online_risk < online_low_risk_threshold_) {
+                        quota = online_low_risk_quota_;
+                    } else if (result.online_risk < online_hold_threshold_) {
+                        quota = online_mid_risk_quota_;
+                    } else if (result.online_risk < online_high_risk_threshold_) {
+                        quota = online_high_risk_quota_;
+                    }
+                }
+                const bool freshness_rescue =
+                    result.u_fresh >= online_fresh_rescue_threshold_;
+                if (freshness_rescue) quota = std::max(quota, 2);
+                const double deadline_charge_ms = std::min(
+                    queued_quantum_ms, online_deadline_charge_cap_ms_);
+                const bool deadline_fit =
+                    laxity >= deadline_charge_ms + online_gap_guard_ms_;
+                admit = online_overlap_quanta_ < quota &&
+                        (deadline_fit || (freshness_rescue && laxity > 1.0));
+                count_overlap_quantum = admit;
+            }
+        } else if (result.task_valid) {
+            double horizon_ms = result.time_to_next_high_risk_ms;
+            if (result.pmu_valid && result.online_risk < online_hold_threshold_) {
+                horizon_ms += online_release_cross_allow_ms_;
+            }
+            admit = horizon_ms >= queued_quantum_ms + online_gap_guard_ms_;
+            if (!admit &&
+                result.u_fresh >= online_fresh_rescue_threshold_ &&
+                result.online_risk < online_high_risk_threshold_) {
+                admit = true;
+            }
+        }
+
+        const uint64_t now = monotonic_ns();
+        if (!admit) {
+            if (online_hold_begin_ns_ == 0) online_hold_begin_ns_ = now;
+            const double held_ms = static_cast<double>(now - online_hold_begin_ns_) / 1e6;
+            if (online_max_hold_ms_ >= 0.0 &&
+                held_ms >= online_max_hold_ms_ &&
+                result.online_risk < online_high_risk_threshold_ && laxity > 1.0) {
+                admit = true;
+                if (foreground_active) count_overlap_quantum = true;
+            }
+        }
+        admit = apply_active_frame_budget(result, graph_phase, foreground_active, admit);
+        if (admit && count_overlap_quantum) ++online_overlap_quanta_;
+        if (!admit && online_hold_begin_ns_ == 0) online_hold_begin_ns_ = now;
+        if (admit) online_hold_begin_ns_ = 0;
+
+        const bool pipeline_quantum = admit &&
+            (graph_phase == phase::prefill || graph_phase == phase::decode);
+        result.selected_mode = !admit ? mode::hold :
+            pipeline_quantum ? mode::normal : mode::protected_mode;
+        result.outstanding_limit = !admit ? 0 :
+            pipeline_quantum ? (foreground_active ? 1 : 2) : 1;
+        return result;
+    }
+
+    decision evaluate_frame_oracle(phase graph_phase, decision result) {
+        const bool foreground_active =
+            std::strcmp(result.fg_phase, "fg_active") == 0;
+        const double queued_ms = outstanding_service_ms_ + result.next_quantum_ms;
+        const bool body_quantum = result.next_quantum_ms <= oracle_body_max_ms_;
+        const bool protected_frame = std::binary_search(
+            oracle_hold_frames_.begin(), oracle_hold_frames_.end(), result.frame_id);
+        bool admit = !result.task_valid || !foreground_active || !protected_frame;
+
+        // Body quanta follow the fixed posterior action sequence. Terminal
+        // tails are never probes and must fit their complete current horizon.
+        if (admit && !body_quantum && result.task_valid) {
+            const double horizon_ms = foreground_active
+                ? result.fg_deadline_remaining_ms
+                : result.time_to_next_high_risk_ms;
+            admit = queued_ms + oracle_terminal_guard_ms_ <= horizon_ms;
+        }
+        const bool pipeline_quantum = admit &&
+            (graph_phase == phase::prefill || graph_phase == phase::decode);
+        result.selected_mode = !admit ? mode::hold :
+            pipeline_quantum ? mode::normal : mode::protected_mode;
+        result.outstanding_limit = admit ? 1 : 0;
+        return result;
+    }
+
+    decision evaluate_slo_budget(phase graph_phase, double next_quantum_ms) {
+        decision result{};
+        for (int attempt = 0; attempt < 8; ++attempt) {
+            const uint64_t before = rt_state_.sequence.load(std::memory_order_acquire);
+            if (before & 1U) continue;
+            result.task_valid = rt_state_.task_valid.load(std::memory_order_relaxed);
+            result.request_valid = rt_state_.request_valid.load(std::memory_order_relaxed);
+            result.request_id = rt_state_.request_id.load(std::memory_order_relaxed);
+            result.mc_valid = rt_state_.mc_valid.load(std::memory_order_relaxed);
+            result.mc_activity = rt_state_.mc_activity.load(std::memory_order_relaxed);
+            result.u_mc = rt_state_.mc_pressure.load(std::memory_order_relaxed);
+            result.fg_deadline_remaining_ms = ns_to_ms_signed(
+                rt_state_.deadline_remaining_us.load(std::memory_order_relaxed) * 1000);
+            result.fg_predicted_remaining_ms = ns_to_ms_signed(
+                rt_state_.predicted_fg_remaining_us.load(std::memory_order_relaxed) * 1000);
+            result.time_to_next_high_risk_ms = ns_to_ms_signed(
+                rt_state_.time_to_next_risk_us.load(std::memory_order_relaxed) * 1000);
+            result.vlm_freshness_remaining_ms = ns_to_ms_signed(
+                rt_state_.freshness_remaining_us.load(std::memory_order_relaxed) * 1000);
+            result.estimated_remaining_service_ms = ns_to_ms_signed(
+                rt_state_.estimated_remaining_service_us.load(std::memory_order_relaxed) * 1000);
+            result.safe_budget_ms = ns_to_ms_signed(
+                rt_state_.current_safe_budget_us.load(std::memory_order_relaxed) * 1000);
+            result.admission_budget_ms = ns_to_ms_signed(
+                rt_state_.admission_budget_us.load(std::memory_order_relaxed) * 1000);
+            result.total_guard_ms = ns_to_ms_signed(
+                rt_state_.total_guard_us.load(std::memory_order_relaxed) * 1000);
+            result.freshness_reserve_ms = ns_to_ms_signed(
+                rt_state_.freshness_reserve_us.load(std::memory_order_relaxed) * 1000);
+            result.yield_requested =
+                rt_state_.yield_requested.load(std::memory_order_relaxed);
+            const auto observed_phase = static_cast<conserve::fg_phase>(
+                rt_state_.fg_phase.load(std::memory_order_relaxed));
+            result.fg_phase = observed_phase == conserve::fg_phase::fg_high_risk
+                ? "fg_active" : observed_phase == conserve::fg_phase::tracking
+                    ? "tracking" : "low";
+            const uint64_t after = rt_state_.sequence.load(std::memory_order_acquire);
+            if (before == after && !(after & 1U)) break;
+        }
+        result.next_quantum_ms = next_quantum_ms;
+        result.u_fresh = urgency(
+            result.vlm_freshness_remaining_ms -
+                result.estimated_remaining_service_ms,
+            static_cast<double>(slo_parameters_.freshness_warning_us) / 1000.0);
+        result.crosses_high_risk = next_quantum_ms > result.safe_budget_ms;
+        result.freshness_recoverable = result.request_valid &&
+            result.vlm_freshness_remaining_ms > 0.0;
+
+        const bool can_admit = result.task_valid && result.request_valid &&
+            next_quantum_ms <= result.admission_budget_ms;
+        result.selected_mode = can_admit && !result.yield_requested
+            ? mode::normal : mode::hold;
+        result.outstanding_limit = result.selected_mode == mode::hold ? 0 : 1;
+        (void) graph_phase;
+        return result;
+    }
+
+    static conserve::fg_phase fill_slo_fg_state(
+            const edgepace_task_snapshot_v1 & task, bool valid, uint64_t now,
+            decision & result) {
+        constexpr double fallback_response_ms = 20.0;
+        result.fg_deadline_remaining_ms = 33.333;
+        result.fg_predicted_remaining_ms = fallback_response_ms;
+        result.time_to_next_high_risk_ms = 33.333;
+        result.fg_phase = "low";
+        if (!valid) return conserve::fg_phase::low;
+
+        const edgepace_task_frame_v1 * latest = nullptr;
+        for (const auto & frame : task.frame_ledger) {
+            if ((frame.flags & EDGEPACE_TASK_FRAME_VALID) == 0) continue;
+            if (latest == nullptr || frame.frame_id > latest->frame_id) latest = &frame;
+        }
+        if (latest == nullptr) return conserve::fg_phase::low;
+
+        const double prediction_ms = task.odom_ewma_response_ns > 0
+            ? static_cast<double>(task.odom_ewma_response_ns) / 1e6
+            : fallback_response_ms;
+        const bool incomplete = (latest->flags & EDGEPACE_TASK_FRAME_COMPLETE) == 0;
+        if (incomplete) {
+            const double elapsed_ms = now > latest->release_ns
+                ? static_cast<double>(now - latest->release_ns) / 1e6 : 0.0;
+            result.fg_deadline_remaining_ms = ns_to_ms_signed(
+                static_cast<int64_t>(latest->deadline_ns) -
+                static_cast<int64_t>(now));
+            result.fg_predicted_remaining_ms =
+                std::max(0.0, prediction_ms - elapsed_ms);
+            const double laxity_ms = result.fg_deadline_remaining_ms -
+                                     result.fg_predicted_remaining_ms;
+            if (task.callback_queue_depth > 1 || laxity_ms <= 0.0) {
+                result.time_to_next_high_risk_ms = 0.0;
+                result.fg_phase = "fg_active";
+                return conserve::fg_phase::fg_high_risk;
+            }
+            result.time_to_next_high_risk_ms =
+                std::max(0.0, result.fg_deadline_remaining_ms);
+            result.fg_phase = "tracking";
+            return conserve::fg_phase::tracking;
+        }
+
+        const uint64_t next_release = task.next_odom_release_ns != 0
+            ? task.next_odom_release_ns
+            : latest->release_ns + UINT64_C(33333333);
+        const uint64_t next_deadline = task.next_odom_deadline_ns != 0
+            ? task.next_odom_deadline_ns
+            : latest->deadline_ns + UINT64_C(33333333);
+        result.fg_deadline_remaining_ms = ns_to_ms_signed(
+            static_cast<int64_t>(next_deadline) - static_cast<int64_t>(now));
+        result.fg_predicted_remaining_ms = prediction_ms;
+        result.time_to_next_high_risk_ms = std::max(
+            0.0, ns_to_ms_signed(static_cast<int64_t>(next_release) -
+                                 static_cast<int64_t>(now)));
+        return conserve::fg_phase::low;
+    }
+
+    void monitor_loop() {
+        while (monitor_running_.load(std::memory_order_relaxed)) {
+            const uint64_t now = monotonic_ns();
+            decision observed{};
+
+            edgepace_request_state_v1 request{};
+            observed.request_valid = pages_.request(request) && request.running != 0;
+            double completed_service_ms = 0.0;
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                if (observed.request_valid) reset_request_if_needed(request.request_id);
+                completed_service_ms = completed_service_ms_;
+                observed.request_id = observed.request_valid
+                    ? request.request_id : current_request_id_;
+            }
+            observed.vlm_freshness_remaining_ms = observed.request_valid
+                ? ns_to_ms_signed(static_cast<int64_t>(request.freshness_deadline_ns) -
+                                  static_cast<int64_t>(now))
+                : freshness_ttl_ms_;
+            observed.estimated_remaining_service_ms = std::max(
+                0.0, total_service_ms_ - completed_service_ms);
+
+            edgepace_task_snapshot_v1 task{};
+            observed.task_valid = pages_.task(task);
+            if (observed.task_valid && task.second_odom_deadline_ns != 0 &&
+                now > task.second_odom_deadline_ns) {
+                observed.task_valid = false;
+            }
+            const conserve::fg_phase phase_value = fill_slo_fg_state(
+                task, observed.task_valid, now, observed);
+
+            edgepace_actmon_snapshot_v1 actmon{};
+            if (pages_.actmon(actmon) && actmon.header.flags != 0 &&
+                now >= actmon.update_ns && now - actmon.update_ns <= maximum_mc_age_ns_) {
+                observed.mc_valid = true;
+                observed.mc_activity = actmon.raw_activity;
+                observed.u_mc = clamp01(
+                    (static_cast<double>(actmon.raw_activity) - mc_low_) /
+                    (mc_high_ - mc_low_));
+            }
+
+            const uint64_t safepoint_deadline =
+                active_safepoint_deadline_ns_.load(std::memory_order_relaxed);
+            const int64_t remaining_to_safepoint_us = safepoint_deadline > now
+                ? static_cast<int64_t>((safepoint_deadline - now) / 1000) : 0;
+            conserve::budget_input input{};
+            input.phase = phase_value;
+            input.deadline_remaining_us = static_cast<int64_t>(std::llround(
+                observed.fg_deadline_remaining_ms * 1000.0));
+            input.predicted_fg_remaining_us = static_cast<int64_t>(std::llround(
+                observed.fg_predicted_remaining_ms * 1000.0));
+            input.time_to_next_risk_us = static_cast<int64_t>(std::llround(
+                observed.time_to_next_high_risk_ms * 1000.0));
+            input.freshness_remaining_us = static_cast<int64_t>(std::llround(
+                observed.vlm_freshness_remaining_ms * 1000.0));
+            input.estimated_remaining_vlm_service_us = static_cast<int64_t>(std::llround(
+                observed.estimated_remaining_service_ms * 1000.0));
+            input.remaining_to_next_safepoint_us = remaining_to_safepoint_us;
+            input.mc_valid = observed.mc_valid;
+            input.mc_pressure = observed.u_mc;
+            const conserve::budget_decision budget =
+                conserve::compute_budget(input, slo_parameters_);
+
+            rt_state_.sequence.fetch_add(1, std::memory_order_acq_rel);
+            rt_state_.fg_phase.store(static_cast<int>(phase_value), std::memory_order_relaxed);
+            rt_state_.deadline_remaining_us.store(input.deadline_remaining_us, std::memory_order_relaxed);
+            rt_state_.predicted_fg_remaining_us.store(input.predicted_fg_remaining_us, std::memory_order_relaxed);
+            rt_state_.time_to_next_risk_us.store(input.time_to_next_risk_us, std::memory_order_relaxed);
+            rt_state_.mc_pressure.store(static_cast<float>(input.mc_pressure), std::memory_order_relaxed);
+            rt_state_.freshness_remaining_us.store(input.freshness_remaining_us, std::memory_order_relaxed);
+            rt_state_.estimated_remaining_service_us.store(input.estimated_remaining_vlm_service_us, std::memory_order_relaxed);
+            rt_state_.current_safe_budget_us.store(budget.safe_budget_us, std::memory_order_relaxed);
+            rt_state_.admission_budget_us.store(budget.admission_budget_us, std::memory_order_relaxed);
+            rt_state_.total_guard_us.store(budget.total_guard_us, std::memory_order_relaxed);
+            rt_state_.freshness_reserve_us.store(budget.freshness_reserve_us, std::memory_order_relaxed);
