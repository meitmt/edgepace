+    void fill_fg_state(const edgepace_task_snapshot_v1 & task,
+                         bool valid, uint64_t now, decision & result) {
+        const double fallback_response_ms = fallback_response_ms_;
+        result.fg_deadline_remaining_ms = fallback_deadline_ms_;
+        result.fg_predicted_remaining_ms = fallback_response_ms;
+        result.time_to_next_high_risk_ms = fallback_period_ms_;
+        result.fg_phase = "low";
+        if (!valid) return;
+
+        const edgepace_task_frame_v1 * latest = nullptr;
+        for (const auto & frame : task.frame_ledger) {
+            if ((frame.flags & EDGEPACE_TASK_FRAME_VALID) == 0) continue;
+            if (latest == nullptr || frame.frame_id > latest->frame_id) latest = &frame;
+        }
+        if (latest == nullptr) return;
+        result.frame_id = latest->frame_id;
+
+        const bool incomplete =
+            (latest->flags & EDGEPACE_TASK_FRAME_COMPLETE) == 0;
+        double prediction_ms = task.odom_ewma_response_ns > 0
+            ? static_cast<double>(task.odom_ewma_response_ns) / 1e6
+            : fallback_response_ms;
+#ifdef EDGEPACE_G2_THROUGHPUT
+        // A late completion's queue tail is a fact about the previous frame.
+        // Do not carry that feedback into the next frame's first admission
+        // assessment; use the configured cold-start response estimate instead.
+        if (incomplete) {
+            const edgepace_task_frame_v1 * previous = nullptr;
+            for (const auto & frame : task.frame_ledger) {
+                if ((frame.flags & EDGEPACE_TASK_FRAME_VALID) == 0 ||
+                    frame.frame_id >= latest->frame_id ||
+                    latest->frame_id - frame.frame_id != 1) {
+                    continue;
+                }
+                previous = &frame;
+            }
+            const bool previous_missed = previous != nullptr &&
+                (previous->flags & EDGEPACE_TASK_FRAME_COMPLETE) != 0 &&
+                previous->complete_ns != 0 && previous->deadline_ns != 0 &&
+                previous->complete_ns > previous->deadline_ns;
+            if (previous_missed) prediction_ms = fallback_response_ms;
+        }
+#endif
+        if (incomplete) {
+            const double elapsed_ms = now > latest->release_ns
+                ? static_cast<double>(now - latest->release_ns) / 1e6 : 0.0;
+            result.foreground_elapsed_ms = now > latest->dequeue_ns
+                ? static_cast<double>(now - latest->dequeue_ns) / 1e6 : 0.0;
+            result.fg_deadline_remaining_ms = ns_to_ms_signed(
+                static_cast<int64_t>(latest->deadline_ns) -
+                static_cast<int64_t>(now));
+            result.fg_predicted_remaining_ms =
+                std::max(0.0, prediction_ms - elapsed_ms);
+            result.fg_since_release_ms = elapsed_ms;
+            // the historical estimate also follows the last response,
+            // so a slow frame raises the next frame's early-frame estimate
+            result.fg_recent_response_ms = std::max(
+                prediction_ms, static_cast<double>(task.odom_last_response_ns) / 1e6);
+            result.time_to_next_high_risk_ms = 0.0;
+            result.fg_phase = "fg_active";
+        } else {
+            const uint64_t next_release = task.next_odom_release_ns != 0
+                ? task.next_odom_release_ns
+            : latest->release_ns + static_cast<uint64_t>(fallback_period_ms_ * 1e6);
+            const uint64_t next_deadline = task.next_odom_deadline_ns != 0
+                ? task.next_odom_deadline_ns
+            : latest->deadline_ns + static_cast<uint64_t>(fallback_period_ms_ * 1e6);
+            result.fg_deadline_remaining_ms = ns_to_ms_signed(
+                static_cast<int64_t>(next_deadline) - static_cast<int64_t>(now));
+            result.fg_predicted_remaining_ms = prediction_ms;
+            result.time_to_next_high_risk_ms = std::max(
+                0.0, ns_to_ms_signed(static_cast<int64_t>(next_release) -
+                                     static_cast<int64_t>(now)));
+        }
+    }
