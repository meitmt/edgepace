+static void ggml_backend_sched_edgepace_complete_oldest(ggml_backend_sched_t sched) {
+    GGML_ASSERT(sched->edgepace_pending_count > 0);
+    auto & pending = sched->edgepace_pending[sched->edgepace_pending_head];
+    if (pending.event != nullptr) {
+        ggml_backend_event_synchronize(pending.event);
+    } else {
+        // A quantum can span splits on several backends (e.g. CPU and HTP on
+        // Android). Without events, fence all of them before reporting its
+        // completion. Backends with events (CUDA) never take this branch.
+        for (int i = 0; i < sched->n_backends; ++i) {
+            ggml_backend_synchronize(sched->backends[i]);
+        }
+    }
+    pending.active = false;
+    sched->edgepace_pending_head = (sched->edgepace_pending_head + 1) % GGML_EDGEPACE_MAX_OUTSTANDING;
+    --sched->edgepace_pending_count;
+    ggml_edgepace::runtime::instance().completed(
+        pending.value, sched->edgepace_pending_count, ggml_edgepace::monotonic_ns());
+}
+
+static void ggml_backend_sched_edgepace_drain(ggml_backend_sched_t sched) {
+    while (sched->edgepace_pending_count > 0) {
+        ggml_backend_sched_edgepace_complete_oldest(sched);
+    }
+}
