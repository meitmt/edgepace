+static ggml_edgepace::decision ggml_backend_sched_edgepace_before(
+        ggml_backend_sched_t sched, const ggml_backend_sched_split * split,
+        uint64_t execution_id) {
+    auto & runtime = ggml_edgepace::runtime::instance();
+    bool waiting_in_hold = false;
+    for (;;) {
+        const double predicted_ms = split->edgepace_phase == ggml_edgepace::phase::decode
+            ? runtime.next_decode_runtime_ms(split->edgepace_quantum_id) : split->edgepace_runtime_ms;
+        ggml_edgepace::decision admitted = runtime.evaluate(
+            split->edgepace_phase, predicted_ms, split->edgepace_quantum_id,
+            sched->edgepace_pending_count, execution_id);
+        if ((admitted.flags & EDGEPACE_POLICY_DECISION_NATURAL) != 0) {
+            admitted.selected_mode = ggml_edgepace::mode::normal;
+            // Natural/fast path remains free of ADMIT events.  Keep a small
+            // two-quantum sliding window, however, so a later risk transition
+            // cannot inherit an unbounded queue of already-submitted work.
+            // Waiting here only consumes the oldest completion event when the
+            // window is full; it does not add a policy gate or synchronization
+            // between the two continuously submitted quanta.
+            admitted.outstanding_limit = 2;
+            if (sched->edgepace_pending_count >= admitted.outstanding_limit) {
+                ggml_backend_sched_edgepace_complete_oldest(sched);
+            }
+            return admitted;
+        }
+        if (admitted.selected_mode == ggml_edgepace::mode::hold) {
+            if (!waiting_in_hold) {
+                runtime.admission("hold_begin", split->edgepace_phase,
+                    split->edgepace_quantum_id, execution_id, admitted,
+                    sched->edgepace_pending_count, 0);
+            }
+            ggml_backend_sched_edgepace_drain(sched);
+            waiting_in_hold = true;
+            usleep(1000);
+            continue;
+        }
+        if (waiting_in_hold) {
+            runtime.admission("hold_end", split->edgepace_phase,
+                split->edgepace_quantum_id, execution_id, admitted,
+                sched->edgepace_pending_count, admitted.outstanding_limit);
+            waiting_in_hold = false;
+        }
+        if (sched->edgepace_pending_count >= admitted.outstanding_limit &&
+            sched->edgepace_pending_count > 0) {
+            ggml_backend_sched_edgepace_complete_oldest(sched);
+            continue;
+        }
+        runtime.admission("admit", split->edgepace_phase,
+            split->edgepace_quantum_id, execution_id, admitted,
+            sched->edgepace_pending_count, admitted.outstanding_limit);
+        return admitted;
+    }
